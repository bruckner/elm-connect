    Proto.Binary.levels mergeChainBytesLevel


{-| [`mergeChainBytes`](#mergeChainBytes) built for one nesting depth.
-}
mergeChainBytesLevel : Int -> Chain -> Proto.Binary.Decoder Chain
mergeChainBytesLevel depth =
    Proto.Binary.mergeKeep
        "cycles.v1.Chain"
        (\number ->
            case number of
                1 ->
                    4

                2 ->
                    4

                _ ->
                    0
        )
        (\value -> value.unknownFields_)
        (\v value ->
            { label = value.label
            , next = value.next
            , unknownFields_ = v
            }
        )
        (\number wire value ->
            case number of
                1 ->
                    Proto.Binary.field
                        Proto.Binary.string
                        (\v ->
                            { label = v
                            , next = value.next
                            , unknownFields_ = value.unknownFields_
                            }
                        )
                        wire
                        value

                2 ->
                    Proto.Binary.fieldInto
                        (Proto.Binary.recursive depth encodeChain_Bytes mergeChain_BytesAt (Chain_ defaultChain))
                        value.next
                        (\v ->
                            { label = value.label
                            , next = Just v
                            , unknownFields_ = value.unknownFields_
                            }
                        )
                        wire
                        value

                _ ->
                    Proto.Binary.skip wire value
        )
        identity


