{-| Decode one field of a message in a decoding pipeline. A missing key or a
JSON `null` gives the default, the field's proto3 zero value; any other value
must satisfy the decoder.

    type alias Note =
        { title : String, stars : Int }

    decodeNote : Decoder Note
    decodeNote =
        Json.Decode.succeed Note
            |> field "title" "" Json.Decode.string
            |> field "stars" 0 int32

The value being decoded must be a JSON object.

The default says what absence means, so one step serves every field shape: a
field with presence (a message-typed or proto3 `optional` field) defaults to
`Nothing` and maps its decoder with `Just`, a repeated field defaults to `[]`
and decodes with `Json.Decode.list`.

    |> field "author" Nothing (Json.Decode.map Just decodeAuthor)
    |> field "tags" [] (Json.Decode.list Json.Decode.string)

-}
field : String -> a -> Decoder a -> Decoder (a -> b) -> Decoder b
field name default decoder =
    Json.Decode.map2 (|>) (valueAt [ name ] default decoder)


{-| [`field`](#field) for a field whose JSON name differs from its proto name:
the JSON name first, then the proto name. proto3 JSON parsers accept either
key; when both are present, the JSON name wins.

    |> fieldEither "displayName" "display_name" "" Json.Decode.string

-}
fieldEither : String -> String -> a -> Decoder a -> Decoder (a -> b) -> Decoder b
fieldEither jsonName protoName default decoder =
    Json.Decode.map2 (|>) (valueAt [ jsonName, protoName ] default decoder)


{-| The value under the first of `names` the object holds, decoded; `default`
when it holds none of them or holds `null`.
-}
valueAt : List String -> a -> Decoder a -> Decoder a
valueAt names default decoder =
    Json.Decode.dict Json.Decode.value
        |> Json.Decode.andThen
            (\object ->
                case firstPresent names object of
                    Nothing ->
                        Json.Decode.succeed default

                    Just ( name, raw ) ->
                        if isNull raw then
                            Json.Decode.succeed default

                        else
                            Json.Decode.field name decoder
            )


firstPresent : List String -> Dict.Dict String Value -> Maybe ( String, Value )
firstPresent names object =
    case names of
        [] ->
            Nothing

        name :: rest ->
            case Dict.get name object of
                Just raw ->
                    Just ( name, raw )

                Nothing ->
                    firstPresent rest object


isNull : Value -> Bool
isNull raw =
    Json.Decode.decodeValue (Json.Decode.null ()) raw == Ok ()


{-| Encode a field with presence: `Nothing` as JSON `null`, which proto3 JSON
reads as an absent field, and a value with the given encoder.

    encodeMaybe Json.Encode.int (Just 3) -- 3

    encodeMaybe Json.Encode.int Nothing -- null

-}
encodeMaybe : (a -> Value) -> Maybe a -> Value
encodeMaybe encode maybe =
    case maybe of
        Just value ->
            encode value

        Nothing ->
            Json.Encode.null


{-| Decode a oneof in a decoding pipeline: unlike [`field`](#field), the
decoder reads the message object itself, since each member of a oneof is a
key of the message.

    type NoteKind
        = NoteKindUnset
        | NoteKindText String

    decodeNote : Decoder Note
    decodeNote =
        Json.Decode.succeed Note
            |> field "title" "" Json.Decode.string
            |> oneof decodeNoteKind

-}
oneof : Decoder a -> Decoder (a -> b) -> Decoder b
oneof decoder =
    Json.Decode.map2 (|>) decoder


{-| Decode one member of a oneof: succeeds only when the object holds the key
with a value other than `null`, which proto3 JSON reads as unset. A oneof's
decoder tries each member in turn and falls back to its unset constructor:

    decodeNoteKind : Decoder NoteKind
    decodeNoteKind =
        Json.Decode.oneOf
            [ member "text" (Json.Decode.map NoteKindText Json.Decode.string)
            , Json.Decode.succeed NoteKindUnset
            ]

A member whose value does not satisfy its decoder fails too, so the oneof reads
as unset.

-}
member : String -> Decoder a -> Decoder a
member name =
    present [ name ]


{-| [`member`](#member) for a member whose JSON name differs from its proto
name: the JSON name first, then the proto name, as in
[`fieldEither`](#fieldEither).
-}
memberEither : String -> String -> Decoder a -> Decoder a
memberEither jsonName protoName =
    present [ jsonName, protoName ]


present : List String -> Decoder a -> Decoder a
present names decoder =
    Json.Decode.dict Json.Decode.value
        |> Json.Decode.andThen
            (\object ->
                case firstPresent names object of
                    Just ( name, raw ) ->
                        if isNull raw then
                            Json.Decode.fail ("Expecting a value at " ++ name ++ ", but got null")

                        else
                            Json.Decode.field name decoder

                    Nothing ->
                        Json.Decode.fail ("Expecting a key " ++ String.join " or " names)
            )


{-| Decode an enum, given its zero value and every value's proto name,
number and constructor. proto3 JSON writes an enum as its value's name, and a
parser must also accept the number. A name or number the table does not hold,
such as a value added to the server's proto after this client was generated,
decodes as the zero value.

    type Status
        = StatusUnspecified
        | StatusActive

    decodeStatus : Decoder Status
    decodeStatus =
        enum StatusUnspecified
            [ ( "STATUS_UNSPECIFIED", 0, StatusUnspecified )
            , ( "STATUS_ACTIVE", 1, StatusActive )
            ]

When two entries share a name or a number, the first wins.

-}
enum : a -> List ( String, Int, a ) -> Decoder a
enum zero values =
    let
        lookup matches =
            values
                |> List.filter matches
                |> List.head
                |> Maybe.map (\( _, _, value ) -> value)
                |> Maybe.withDefault zero
    in
    Json.Decode.oneOf
        [ Json.Decode.string
            |> Json.Decode.map (\text -> lookup (\( name, _, _ ) -> name == text))
        , Json.Decode.int
            |> Json.Decode.map (\int -> lookup (\( _, number, _ ) -> number == int))
        ]


{-| Decode a map with 32-bit integer keys. JSON object keys are strings, so
proto3 JSON writes each key as its decimal string; a key that is not one fails.

    Json.Decode.decodeString (intDict Json.Decode.string) """{"1":"a","-2":"b"}"""
    -- Ok (Dict.fromList [ ( -2, "b" ), ( 1, "a" ) ])

Encode one with `Json.Encode.dict String.fromInt`.

-}
intDict : Decoder a -> Decoder (Dict.Dict Int a)
intDict decoder =
    Json.Decode.keyValuePairs decoder
        |> Json.Decode.andThen
            (\pairs ->
                List.foldr
                    (\( key, value ) result ->
                        Result.map2 (\int dict -> Dict.insert int value dict)
                            (String.toInt key |> Result.fromMaybe key)
                            result
                    )
                    (Ok Dict.empty)
                    pairs
                    |> fromKeyResult
            )


fromKeyResult : Result String (Dict.Dict Int a) -> Decoder (Dict.Dict Int a)
fromKeyResult result =
    case result of
        Ok dict ->
            Json.Decode.succeed dict

        Err key ->
            Json.Decode.fail ("Expecting an integer map key, but got \"" ++ key ++ "\"")


{-| Decode a 32-bit integer (`int32`, `uint32`, `sint32`, `fixed32`,
`sfixed32`).

proto3 JSON writes these as numbers, and a parser must also accept a string
and exponent notation: `42`, `"42"`, `1e2` and `"1e2"` all decode, as does
`4.0`. A value with a fractional part fails. The range of the proto type is not
checked.

-}
int32 : Decoder Int
int32 =
    Json.Decode.oneOf
        [ Json.Decode.int
        , Json.Decode.string |> Json.Decode.andThen int32String
        ]


int32String : String -> Decoder Int
int32String text =
    case String.toInt text of
        Just number ->
            Json.Decode.succeed number

        Nothing ->
            case String.toFloat text of
                Just number ->
                    integral number

                Nothing ->
                    Json.Decode.fail ("Expecting an integer, but got \"" ++ text ++ "\"")


integral : Float -> Decoder Int
integral number =
    if isNaN number || isInfinite number || toFloat (round number) /= number then
        Json.Decode.fail ("Expecting an integer, but got " ++ String.fromFloat number)

    else
        Json.Decode.succeed (round number)


{-| Decode a 64-bit integer (`int64`, `uint64`, `sint64`, `fixed64`,
`sfixed64`) as its decimal string, since Elm's `Int` is exact only up to
2^53.

proto3 JSON writes these as strings, and a parser must accept either a string
or a number. A string must be an optional `-` followed by digits. A number is
rendered back to its decimal string; past 2^53 it was already rounded when the
JSON was parsed, before this decoder saw it.

-}
int64 : Decoder String
int64 =
    Json.Decode.oneOf
        [ Json.Decode.string |> Json.Decode.andThen decimal
        , Json.Decode.map String.fromInt Json.Decode.int
        ]


decimal : String -> Decoder String
decimal text =
    let
        digits =
            if String.startsWith "-" text then
                String.dropLeft 1 text

            else
                text
    in
    if not (String.isEmpty digits) && String.all Char.isDigit digits then
        Json.Decode.succeed text

    else
        Json.Decode.fail ("Expecting a decimal integer, but got \"" ++ text ++ "\"")


{-| Encode a 64-bit integer, held as its decimal string, as proto3 JSON does:
as a JSON string.
-}
encodeInt64 : String -> Value
encodeInt64 =
    Json.Encode.string


{-| Decode a `double` or `float`. proto3 JSON writes a finite value as a
number and the others as the strings `"NaN"`, `"Infinity"` and `"-Infinity"`;
a parser must also accept a finite value written as a string, such as `"1.5"`.
-}
float : Decoder Float
float =
    Json.Decode.oneOf
        [ Json.Decode.float
        , Json.Decode.string |> Json.Decode.andThen floatString
        ]


floatString : String -> Decoder Float
floatString text =
    case text of
        "NaN" ->
            Json.Decode.succeed (0 / 0)

        "Infinity" ->
            Json.Decode.succeed (1 / 0)

        "-Infinity" ->
            Json.Decode.succeed -(1 / 0)

        _ ->
            case String.toFloat text of
                Just number ->
                    Json.Decode.succeed number

                Nothing ->
                    Json.Decode.fail ("Expecting a number, but got \"" ++ text ++ "\"")


{-| Encode a `double` or `float`: a finite value as a JSON number, NaN and the
infinities as the strings proto3 JSON uses for them.
-}
encodeFloat : Float -> Value
encodeFloat number =
    if isNaN number then
        Json.Encode.string "NaN"

    else if isInfinite number then
        if number > 0 then
            Json.Encode.string "Infinity"

        else
            Json.Encode.string "-Infinity"

    else
        Json.Encode.float number


{-| Decode `bytes`, which proto3 JSON writes as a base64 string, as that
string. No base64 validation happens: the string is passed through as it
arrived.
-}
bytes : Decoder String
bytes =
    Json.Decode.string


{-| Encode `bytes`, held as a base64 string, as that string. No base64
validation happens.
-}
encodeBytes : String -> Value
encodeBytes =
    Json.Encode.string


{-| Decode a `google.protobuf.Timestamp`, an RFC 3339 string; see
[`Connect.Timestamp.fromString`](Connect-Timestamp#fromString).
-}
timestamp : Decoder Time.Posix
timestamp =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                case Connect.Timestamp.fromString text of
                    Just posix ->
                        Json.Decode.succeed posix

                    Nothing ->
                        Json.Decode.fail ("Expecting an RFC 3339 timestamp, but got \"" ++ text ++ "\"")
            )


{-| Encode a `google.protobuf.Timestamp`; see
[`Connect.Timestamp.toString`](Connect-Timestamp#toString).
-}
encodeTimestamp : Time.Posix -> Value
encodeTimestamp posix =
    Json.Encode.string (Connect.Timestamp.toString posix)


{-| Decode a `google.protobuf.Duration`, such as `"1.5s"`; see
[`Connect.Duration.fromString`](Connect-Duration#fromString).
-}
duration : Decoder Duration
duration =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                case Connect.Duration.fromString text of
                    Just value ->
                        Json.Decode.succeed value

                    Nothing ->
                        Json.Decode.fail ("Expecting a duration such as \"1.5s\", but got \"" ++ text ++ "\"")
            )


{-| Encode a `google.protobuf.Duration`; see
[`Connect.Duration.toString`](Connect-Duration#toString).
-}
encodeDuration : Duration -> Value
encodeDuration value =
    Json.Encode.string (Connect.Duration.toString value)


{-| Decode a `google.protobuf.FieldMask` into its paths. proto3 JSON writes a
mask as one string, the paths joined by commas, each field name in
lowerCamelCase; the paths come back with proto field names, as a server
expects them:

    Json.Decode.decodeString fieldMask "\"displayName,author.emailAddress\""
    -- Ok [ "display_name", "author.email_address" ]

The empty string is the empty mask.

-}
fieldMask : Decoder (List String)
fieldMask =
    Json.Decode.string
        |> Json.Decode.map
            (\text ->
                if String.isEmpty text then
                    []

                else
                    String.split "," text
                        |> List.map (mapSegments snakeCase)
            )


{-| Encode a `google.protobuf.FieldMask` from its paths, written with proto
field names (`"author.email_address"`): each field name in lowerCamelCase, the
paths joined by commas.
-}
encodeFieldMask : List String -> Value
encodeFieldMask paths =
    paths
        |> List.map (mapSegments camelCase)
        |> String.join ","
        |> Json.Encode.string


mapSegments : (String -> String) -> String -> String
mapSegments convert path =
    String.split "." path
        |> List.map convert
        |> String.join "."


camelCase : String -> String
camelCase name =
    case String.split "_" name of
        first :: rest ->
            first ++ String.concat (List.map capitalize rest)

        [] ->
            name


capitalize : String -> String
capitalize word =
    String.toUpper (String.left 1 word) ++ String.dropLeft 1 word


snakeCase : String -> String
snakeCase name =
    String.toList name
        |> List.concatMap
            (\char ->
                if Char.isUpper char then
                    [ '_', Char.toLower char ]

                else
                    [ char ]
            )
        |> String.fromList


{-| Decode a `google.protobuf.Empty`: any JSON object, usually `{}`.
-}
empty : Decoder ()
empty =
    Json.Decode.keyValuePairs Json.Decode.value
        |> Json.Decode.map (\_ -> ())


{-| Encode a `google.protobuf.Empty` as `{}`.
-}
encodeEmpty : () -> Value
encodeEmpty () =
    Json.Encode.object []
