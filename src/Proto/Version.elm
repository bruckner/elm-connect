module Proto.Version exposing (Generated, v0_2)

{-| Which elm-connect releases this package works with.

Every module elm-connect generates names the release it was generated for:

    elmConnectVersion_ : Proto.Version.Generated
    elmConnectVersion_ =
        Proto.Version.v0_2

If the compiler reports that this module does not expose that name, the
generated code and this package are from different releases. Regenerate with
the elm-connect generator matching this package's version, or install the
version of this package the generated code names (`v0_2` is 0.2.x).

This package exposes the name of every minor release of its major version
whose generated code it can compile, so code generated by an earlier release
compiles against it unless the shape of generated code changed since; code
generated by a later release does not. Before 1.0 a minor release may change
that shape: 0.2 does, so this package names `v0_2` alone.

@docs Generated, v0_2

-}


{-| The type of the names below; generated code holds one.
-}
type Generated
    = Generated


{-| elm-connect 0.2.
-}
v0_2 : Generated
v0_2 =
    Generated
