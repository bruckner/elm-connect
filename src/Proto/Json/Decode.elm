{-| Decode a message without fields: any JSON object, usually `{}`, whatever
its keys. Anything else fails, as it does for a message with fields.

    decodePing : Json.Decode.Decoder Ping
    decodePing =
        emptyMessage

-}
emptyMessage : Json.Decode.Decoder {}
emptyMessage =
    Json.Decode.map (\() -> {}) empty


{-| Decode a message: check that the JSON is an object, not an array, and
then run `fields`, a pipeline from `Json.Decode.succeed` with a
[`field`](#field) step per field. Anything that is not an
object fails with elm/json's `Expecting an OBJECT`.

    decodeNote : Json.Decode.Decoder Note
    decodeNote =
        message
            (Json.Decode.succeed Note
                |> field "title" "" string
                |> field "stars" 0 int32
            )

A [`oneof`](#oneof) step reads the object as it does in any pipeline.

-}
message : Json.Decode.Decoder a -> Json.Decode.Decoder a
message fields =
    Json.Decode.value
        |> Json.Decode.andThen
            (\json ->
                if isObject json then
                    fields

                else
                    notAnObject
            )


{-| Decode one field of a message inside [`message`](#message). A missing key
or a JSON `null` gives the default, the field's proto3 zero value; any other
value must satisfy the decoder.

    type alias Note =
        { title : String, stars : Int }

    decodeNote : Json.Decode.Decoder Note
    decodeNote =
        message
            (Json.Decode.succeed Note
                |> field "title" "" string
                |> field "stars" 0 int32
            )

`message` has checked that the JSON is an object: the step does not check it
again. Outside `message` it may read JSON that is not an object as a message,
every field absent. 0.1's `Proto.Json.field`, of the same type, checked for
itself; a pipeline of it moves into `message`.

The default says what absence means, so one step serves every field shape: a
field with presence (a message-typed or proto3 `optional` field) defaults to
`Nothing` and maps its decoder with `Just`, a repeated field defaults to `[]`
and decodes with `Json.Decode.list`.

    |> field "author" Nothing (Json.Decode.map Just decodeAuthor)
    |> field "tags" [] (Json.Decode.list string)

-}
field : String -> a -> Json.Decode.Decoder a -> Json.Decode.Decoder (a -> b) -> Json.Decode.Decoder b
field name default decoder =
    Json.Decode.map2 (|>) (valueIn [ name ] default decoder)


{-| [`field`](#field) for a field whose JSON name differs from
its proto name: the JSON name first, then the proto name. proto3 JSON parsers
accept either key, but not both: an object holding both fails, even when one
of them is `null`, as protobuf's own parsers reject a duplicate field.

    |> fieldEither "displayName" "display_name" "" string

-}
fieldEither : String -> String -> a -> Json.Decode.Decoder a -> Json.Decode.Decoder (a -> b) -> Json.Decode.Decoder b
fieldEither jsonName protoName default decoder =
    Json.Decode.map2 (|>) (valueIn (spellings jsonName protoName) default decoder)


{-| Decode a field inside [`message`](#message) for which `null` is a value,
not absence, held as a `Maybe`: a missing key gives `Nothing`, and any value
under the key, `null` included, gives `Just` what `decoder` reads from it.

A field of type `google.protobuf.Value` is read so, with
[`nestedValue`](#nestedValue) at its message's depth, which the value's arrays
and objects count on from: `null` is one of a `Value`'s own values, so a field
holding it is set, as protobuf's own parsers read it.

    type alias Setting =
        { name : String, value : Maybe Proto.Value.Value }

    decodeNestedSetting : Int -> Json.Decode.Decoder Setting
    decodeNestedSetting depth =
        message
            (Json.Decode.succeed Setting
                |> field "name" "" string
                |> nullField "value" (nestedValue depth)
            )

To encode one, `Nothing` leaves the field out and `Just` writes its JSON:

    Proto.Json.Encode.checkedObject [ Proto.Json.Encode.checkedFields [ ( "value", Proto.Json.Encode.optional Proto.Json.Encode.value setting.value ) ] ]

-}
nullField : String -> Json.Decode.Decoder a -> Json.Decode.Decoder (Maybe a -> b) -> Json.Decode.Decoder b
nullField name =
    nullFieldEither name name


{-| [`nullField`](#nullField) for a field whose JSON name differs
from its proto name: the JSON name first, then the proto name, as in
[`fieldEither`](#fieldEither).
-}
nullFieldEither : String -> String -> Json.Decode.Decoder a -> Json.Decode.Decoder (Maybe a -> b) -> Json.Decode.Decoder b
nullFieldEither jsonName protoName decoder =
    let
        names =
            spellings jsonName protoName

        present =
            Json.Decode.map Just decoder
    in
    Json.Decode.map2 (|>)
        (Json.Decode.value
            |> Json.Decode.andThen
                (\object_ ->
                    case spelledInObject names object_ of
                        Err problem ->
                            Json.Decode.fail problem

                        Ok (Just ( name, _ )) ->
                            Json.Decode.field name present

                        Ok Nothing ->
                            Json.Decode.succeed Nothing
                )
        )


{-| The value under whichever of `names`, the spellings of one field, the
object holds, decoded; `default` when it holds none of them or holds `null`.
The JSON is already known to be an object, not an array.
-}
valueIn : List String -> a -> Json.Decode.Decoder a -> Json.Decode.Decoder a
valueIn names default decoder =
    Json.Decode.value
        |> Json.Decode.andThen
            (\object_ ->
                case spelledInObject names object_ of
                    Err problem ->
                        Json.Decode.fail problem

                    Ok Nothing ->
                        Json.Decode.succeed default

                    Ok (Just ( name, raw )) ->
                        if isNull raw then
                            Json.Decode.succeed default

                        else
                            Json.Decode.field name decoder
            )


{-| The keys a field may be written under: its JSON name, then its proto name
when that differs.
-}
spellings : String -> String -> List String
spellings jsonName protoName =
    if jsonName == protoName then
        [ jsonName ]

    else
        [ jsonName, protoName ]


{-| What a JSON value holds of one field: nothing when it is not an object;
otherwise which of the field's spellings it holds, with its value, or an error
naming them when it holds more than one.
-}
type Spelled
    = NotAnObject
    | Spelled (Result String (Maybe ( String, Json.Encode.Value )))


{-| Which of `names` an object holds, found among its own keys.
-}
spelledAmongKeys : List String -> Json.Encode.Value -> Spelled
spelledAmongKeys names json =
    case Json.Decode.decodeValue (Json.Decode.dict Json.Decode.value) json of
        Ok keys ->
            Spelled (oneSpelling names (List.filterMap (\name -> Dict.get name keys |> Maybe.map (Tuple.pair name)) names))

        Err _ ->
            NotAnObject


oneSpelling : List String -> List ( String, Json.Encode.Value ) -> Result String (Maybe ( String, Json.Encode.Value ))
oneSpelling names found =
    case found of
        [] ->
            Ok Nothing

        [ one ] ->
            Ok (Just one)

        _ ->
            Err ("Expecting " ++ String.join " or " (List.map quote names) ++ ", but got both")


{-| The value under `name`, when JavaScript's `in` finds it in `json`.
-}
probe : String -> Json.Encode.Value -> Maybe ( String, Json.Encode.Value )
probe name json =
    case Json.Decode.decodeValue (Json.Decode.field name Json.Decode.value) json of
        Ok raw ->
            Just ( name, raw )

        Err _ ->
            Nothing


{-| Whether `name` is a property every object inherits from `Object.prototype`.
-}
isInherited : String -> Bool
isInherited name =
    case name of
        "__proto__" ->
            True

        "__defineGetter__" ->
            True

        "__defineSetter__" ->
            True

        "__lookupGetter__" ->
            True

        "__lookupSetter__" ->
            True

        "constructor" ->
            True

        "hasOwnProperty" ->
            True

        "isPrototypeOf" ->
            True

        "propertyIsEnumerable" ->
            True

        "toLocaleString" ->
            True

        "toString" ->
            True

        "valueOf" ->
            True

        _ ->
            False


{-| Whether a JSON value is an object, in constant time: JavaScript's `in`
finds `hasOwnProperty` in every object and array, which inherit it, and in no
other JSON value, and arrays are told apart. Listing the object's keys would
take time in their number.
-}
isObject : Json.Encode.Value -> Bool
isObject json =
    case Json.Decode.decodeValue (Json.Decode.field "hasOwnProperty" (Json.Decode.succeed ())) json of
        Ok () ->
            not (isArray json)

        Err _ ->
            False


{-| Whether a JSON value is an array, in constant time: decoding its elements
stops at the first, which `fail` rejects, and an empty array decodes.
-}
isArray : Json.Encode.Value -> Bool
isArray json =
    case Json.Decode.decodeValue (Json.Decode.list (Json.Decode.fail "")) json of
        Ok _ ->
            True

        Err (Json.Decode.Index _ _) ->
            True

        Err _ ->
            False


{-| The failure of a message decoder given JSON that is not an object, as
elm/json words it.
-}
notAnObject : Json.Decode.Decoder a
notAnObject =
    Json.Decode.fail "Expecting an OBJECT"


quote : String -> String
quote text =
    "\"" ++ text ++ "\""


isNull : Json.Encode.Value -> Bool
isNull raw =
    case Json.Decode.decodeValue (Json.Decode.null ()) raw of
        Ok () ->
            True

        Err _ ->
            False


{-| Decode a oneof in a decoding pipeline: unlike
[`field`](#field), the decoder reads the message object itself,
since each member of a oneof is a key of the message. The decoder is usually
[`members`](#members).

    type NoteKind
        = NoteKindUnset
        | NoteKindText String

    decodeNote : Json.Decode.Decoder Note
    decodeNote =
        message
            (Json.Decode.succeed Note
                |> field "title" "" string
                |> oneof decodeNoteKind
            )

-}
oneof : Json.Decode.Decoder a -> Json.Decode.Decoder (a -> b) -> Json.Decode.Decoder b
oneof decoder =
    Json.Decode.map2 (|>) decoder


{-| Decode a oneof from the message object, given the oneof's proto name (for
error messages), its unset value and its members:

    decodeNoteKind : Json.Decode.Decoder NoteKind
    decodeNoteKind =
        members "kind"
            NoteKindUnset
            [ member "text" (Json.Decode.map NoteKindText string)
            , memberEither "pageCount" "page_count" (Json.Decode.map NoteKindPageCount int32)
            ]

A member is present when the object holds its key with a value other than
`null`, which proto3 JSON reads as absent; a [`nullMember`](#nullMember) is
present when it holds `null` too.
Then:

  - no member present decodes as the unset value;
  - one member present decodes as that member, and when its value does not
    satisfy the member's decoder the oneof fails, and with it the message;
  - more than one member present fails, naming the keys found:
    `Expecting at most one member of oneof "kind", but got "text" and "pageCount"`.

A member written under both its JSON name and its proto name fails, as a field
does in [`fieldEither`](#fieldEither).

-}
members : String -> a -> List (Member a) -> Json.Decode.Decoder a
members oneofName unset candidates =
    Json.Decode.value
        |> Json.Decode.andThen
            (\object_ ->
                case presentMembers object_ candidates of
                    Nothing ->
                        notAnObject

                    Just (Err problem) ->
                        Json.Decode.fail problem

                    Just (Ok []) ->
                        Json.Decode.succeed unset

                    Just (Ok [ ( name, decoder ) ]) ->
                        Json.Decode.field name decoder

                    Just (Ok several) ->
                        Json.Decode.fail
                            ("Expecting at most one member of oneof "
                                ++ quote oneofName
                                ++ ", but got "
                                ++ listing (List.map (\( name, _ ) -> quote name) several)
                            )
            )


{-| The members the object holds, each with the key it is written under;
`Nothing` when the JSON is not an object.
-}
presentMembers : Json.Encode.Value -> List (Member a) -> Maybe (Result String (List ( String, Json.Decode.Decoder a )))
presentMembers json candidates =
    if isObject json then
        Just (presentIn json candidates [])

    else
        Nothing


presentIn : Json.Encode.Value -> List (Member a) -> List ( String, Json.Decode.Decoder a ) -> Result String (List ( String, Json.Decode.Decoder a ))
presentIn json candidates found =
    case candidates of
        [] ->
            Ok (List.reverse found)

        (Member candidate) :: rest ->
            case spelledInObject candidate.names json of
                Ok (Just ( name, raw )) ->
                    if isNull raw && not candidate.nullIsSet then
                        presentIn json rest found

                    else
                        presentIn json rest (( name, candidate.decoder ) :: found)

                Ok Nothing ->
                    presentIn json rest found

                Err problem ->
                    Err problem


{-| Which of `names`, the spellings of one field, an object holds. The JSON is
already known to be an object, not an array: its shape is not tested again.

`Json.Decode.field` finds a key with JavaScript's `in`, which takes constant
time, so a message of F fields costs O(F) to decode rather than reading the
whole object once per field. `in` also finds what an object inherits, which
for a JSON object is only `Object.prototype`'s properties, so a spelling that
names one of those is looked up among the object's own keys instead, as
`Json.Decode.dict` lists them, which takes time in their number. And `in`
finds an array's `length` and methods, which is why the JSON must be known
not to be an array.

-}
spelledInObject : List String -> Json.Encode.Value -> Result String (Maybe ( String, Json.Encode.Value ))
spelledInObject names json =
    case names of
        [ name ] ->
            if isInherited name then
                spelledAmongOwnKeys names json

            else
                Ok (probe name json)

        _ ->
            if List.any isInherited names then
                spelledAmongOwnKeys names json

            else
                oneSpelling names (List.filterMap (\name -> probe name json) names)


spelledAmongOwnKeys : List String -> Json.Encode.Value -> Result String (Maybe ( String, Json.Encode.Value ))
spelledAmongOwnKeys names json =
    case spelledAmongKeys names json of
        Spelled found ->
            found

        NotAnObject ->
            Ok Nothing


{-| `"a" and "b"`, `"a", "b" and "c"`.
-}
listing : List String -> String
listing items =
    case List.reverse items of
        last :: ((_ :: _) as before) ->
            String.join ", " (List.reverse before) ++ " and " ++ last

        _ ->
            String.concat items


{-| One member of a oneof, for [`members`](#members): the keys it may be
written under and the decoder of its value.
-}
type Member a
    = Member
        { names : List String
        , nullIsSet : Bool
        , decoder : Json.Decode.Decoder a
        }


{-| A member of a oneof: its key and the decoder of its value. A `null` value
reads as absent.

    member "text" (Json.Decode.map NoteKindText string)

A member of type `google.protobuf.Empty`, whose constructor carries nothing,
maps [`empty`](#empty) onto it: it is present when its key holds an object
(usually `{}`), and any value but `null` or an object fails.

    member "clear" (Json.Decode.map (\() -> ActionKindClear) empty)

-}
member : String -> Json.Decode.Decoder a -> Member a
member name =
    memberEither name name


{-| [`member`](#member) for a member whose JSON name differs from its proto
name: the JSON name first, then the proto name, as in
[`fieldEither`](#fieldEither).
-}
memberEither : String -> String -> Json.Decode.Decoder a -> Member a
memberEither jsonName protoName decoder =
    Member { names = spellings jsonName protoName, nullIsSet = False, decoder = decoder }


{-| A member of a oneof for which `null` is a value, not absence: present when
its key holds any value, `null` included, which is given to the decoder.

A member of type `google.protobuf.Value` is read so, with
[`nestedValue`](#nestedValue) at its message's depth: `null` is one of a
`Value`'s own values, so a member present as `null` is set and holds the JSON
`null`, as protobuf's own parsers read it. So is a member of the enum
`google.protobuf.NullValue`, whose constructor carries nothing, with
[`nullValue`](#nullValue), since proto3 JSON writes it as `null`.

    type ActionKind
        = ActionKindUnset
        | ActionKindPayload Proto.Value.Value
        | ActionKindNothing

    decodeNestedActionKind : Int -> Json.Decode.Decoder ActionKind
    decodeNestedActionKind depth =
        members "kind"
            ActionKindUnset
            [ nullMember "payload" (Json.Decode.map ActionKindPayload (nestedValue depth))
            , nullMember "nothing" (Json.Decode.map (\() -> ActionKindNothing) nullValue)
            ]

-}
nullMember : String -> Json.Decode.Decoder a -> Member a
nullMember name =
    nullMemberEither name name


{-| [`nullMember`](#nullMember) for a member whose JSON name differs from its
proto name: the JSON name first, then the proto name, as in
[`fieldEither`](#fieldEither).
-}
nullMemberEither : String -> String -> Json.Decode.Decoder a -> Member a
nullMemberEither jsonName protoName decoder =
    Member { names = spellings jsonName protoName, nullIsSet = True, decoder = decoder }


{-| Decode an enum, given its proto name, its zero value and a row per value
name: the name, its number and its constructor. proto3 JSON writes an enum as
its value's name, and a parser must also accept the number.

A number the rows do not hold, such as one added to the server's proto after
this client was generated, decodes as the zero value. A name the rows do not
hold fails, as protobuf's own parsers do:
`Expecting a value of enum "Status"`, the name it got beside the text in
elm/json's failure; for a decoder
that reads it as the zero value instead, see [`enumOrZero`](#enumOrZero).

    type Status
        = StatusUnspecified
        | StatusActive

    decodeStatus : Json.Decode.Decoder Status
    decodeStatus =
        enum "Status"
            StatusUnspecified
            [ ( "STATUS_UNSPECIFIED", 0, StatusUnspecified )
            , ( "STATUS_ACTIVE", 1, StatusActive )
            , ( "STATUS_LIVE", 1, StatusActive )
            ]

An alias (`allow_alias`) is a second row for the same constructor, so both
names decode to it. When two rows share a name or a number, the first wins.

-}
enum : String -> a -> List ( String, Int, a ) -> Json.Decode.Decoder a
enum enumName zero values =
    enumWith
        (\_ -> Json.Decode.fail ("Expecting a value of enum " ++ quote enumName))
        zero
        values


{-| Decode an enum as [`enum`](#enum) does, with the same arguments, except
that a name the rows do not hold decodes as the zero value too, as an unknown
number does. Nothing a JSON string or integer holds fails; anything else (a
fraction, a boolean, an object) still does, with elm/json's own error. No
failure names the enum, so its name goes unused; it is taken so the two read
alike. Code generated with `enum_unknown=zero` calls this one.

It suits a client that outlives the server's deploys: a value the server adds
reaches it as a name, and with `enum` that fails the whole message it is in.
The zero value is the one proto3 reserves for "unspecified", which is what
makes reading it here sound, but the distinction is dropped: the client cannot
tell the value it does not know from the zero value, and re-encoding sends the
zero value's name.

-}
enumOrZero : String -> a -> List ( String, Int, a ) -> Json.Decode.Decoder a
enumOrZero _ zero values =
    enumWith (\_ -> Json.Decode.succeed zero) zero values


{-| `enum` and `enumOrZero`, which differ in what an unknown name reads as.
-}
enumWith : (String -> Json.Decode.Decoder a) -> a -> List ( String, Int, a ) -> Json.Decode.Decoder a
enumWith unknownName zero values =
    let
        lookup matches =
            values
                |> List.filter matches
                |> List.head
                |> Maybe.map (\( _, _, constructor ) -> constructor)
    in
    Json.Decode.oneOf
        [ Json.Decode.map Ok Json.Decode.string
        , Json.Decode.map Err Json.Decode.int
        ]
        |> Json.Decode.andThen
            (\form ->
                case form of
                    Ok text ->
                        case lookup (\( name, _, _ ) -> name == text) of
                            Just constructor ->
                                Json.Decode.succeed constructor

                            Nothing ->
                                unknownName text

                    Err int ->
                        lookup (\( _, number, _ ) -> number == int)
                            |> Maybe.withDefault zero
                            |> Json.Decode.succeed
            )


{-| Decode a map with `string` keys, each key as [`string`](#string) reads a
value: one holding a UTF-16 surrogate without its pair fails.
-}
stringDict : Json.Decode.Decoder a -> Json.Decode.Decoder (Dict.Dict String a)
stringDict decoder =
    Json.Decode.dict decoder
        |> Json.Decode.andThen
            (\dict ->
                if Dict.foldl (\key _ ok -> ok && isScalarText key) True dict then
                    Json.Decode.succeed dict

                else
                    Json.Decode.fail "Expecting a map key of Unicode text, but got one with a UTF-16 surrogate without its pair"
            )


{-| Decode a `string`. JavaScript's JSON parser reads an escaped UTF-16
surrogate without its pair, such as `"\udc00"`, into the string as it is,
though such a string is not Unicode text and has no UTF-8 form; this fails on
one, as protobuf's parsers do.
-}
string : Json.Decode.Decoder String
string =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                if isScalarText text then
                    Json.Decode.succeed text

                else
                    Json.Decode.fail "Expecting Unicode text, but got a string with a UTF-16 surrogate without its pair"
            )


{-| Whether `text` holds no UTF-16 surrogate without its pair.
-}
isScalarText : String -> Bool
isScalarText =
    Percent.wellFormed


{-| Decode a map with signed 32-bit integer keys (`int32`, `sint32`,
`sfixed32`). JSON object keys are strings, so proto3 JSON writes each key as
its decimal string. A key is an integer written as an `int64` string may be,
in decimal or exponent notation, within -2147483648 to 2147483647: `"7"`,
`"-7"`, `"1e2"`, and `"07"`, whose leading zero protobuf's own parsers accept
too. Any other key fails, such as `"abc"`, `"1.5"`, `"+5"` or `"2147483648"`,
and so do two keys that name one integer, such as `"7"` and `"07"`.

    Json.Decode.decodeString (int32Dict string) """{"1":"a","-2":"b"}"""
    -- Ok (Dict.fromList [ ( -2, "b" ), ( 1, "a" ) ])

Encode one with `Json.Encode.dict String.fromInt`.

-}
int32Dict : Json.Decode.Decoder a -> Json.Decode.Decoder (Dict.Dict Int a)
int32Dict =
    keyedDict (boundedKey "an int32 map key (-2147483648 to 2147483647)" -2147483648 2147483647)


{-| Decode a map with unsigned 32-bit integer keys (`uint32`, `fixed32`): the
keys [`int32Dict`](#int32Dict) accepts, within 0 to 4294967295.
-}
uint32Dict : Json.Decode.Decoder a -> Json.Decode.Decoder (Dict.Dict Int a)
uint32Dict =
    keyedDict (boundedKey "a uint32 map key (0 to 4294967295)" 0 4294967295)


{-| Decode a map with signed 64-bit integer keys (`int64`, `sint64`,
`sfixed64`), keyed by decimal strings as [`int64`](#int64) holds its values,
whatever the `int64` option. A key is read as `int64` reads a string, within
-9223372036854775808 to 9223372036854775807, and held in its canonical form:
`"007"` is the key `"7"`, `"1e3"` the key `"1000"`. Any other key fails, such
as `"abc"`, `"1.5"` or `"9223372036854775808"`, and so do two keys that name
one integer, such as `"7"` and `"007"`.

    Json.Decode.decodeString (int64Dict string) """{"007":"a","-2":"b"}"""
    -- Ok (Dict.fromList [ ( "-2", "b" ), ( "7", "a" ) ])

Encode one with `Json.Encode.dict identity`.

-}
int64Dict : Json.Decode.Decoder a -> Json.Decode.Decoder (Dict.Dict String a)
int64Dict =
    keyedDict (wideKey "an int64 map key" Signed)


{-| Decode a map with unsigned 64-bit integer keys (`uint64`, `fixed64`): the
keys [`int64Dict`](#int64Dict) accepts, within 0 to 18446744073709551615
(2^64 - 1).
-}
uint64Dict : Json.Decode.Decoder a -> Json.Decode.Decoder (Dict.Dict String a)
uint64Dict =
    keyedDict (wideKey "a uint64 map key" Unsigned)


{-| A map whose keys `readKey` reads from their text, failing on a key it
rejects and on two keys it reads as one.
-}
keyedDict : (String -> Result String comparable) -> Json.Decode.Decoder a -> Json.Decode.Decoder (Dict.Dict comparable a)
keyedDict readKey decoder =
    Json.Decode.keyValuePairs decoder
        |> Json.Decode.andThen (\pairs -> fromResult (insertKeys readKey Dict.empty Dict.empty pairs))


insertKeys : (String -> Result String comparable) -> Dict.Dict comparable String -> Dict.Dict comparable a -> List ( String, a ) -> Result String (Dict.Dict comparable a)
insertKeys readKey seen entries pairs =
    case pairs of
        [] ->
            Ok entries

        ( text, entry ) :: rest ->
            case readKey text of
                Err problem ->
                    Err problem

                Ok key ->
                    case Dict.get key seen of
                        Just _ ->
                            Err "Expecting distinct map keys"

                        Nothing ->
                            insertKeys readKey (Dict.insert key text seen) (Dict.insert key entry entries) rest


{-| A 32-bit integer map key within `low` to `high`, read as an `int64` string
is.
-}
boundedKey : String -> Int -> Int -> String -> Result String Int
boundedKey what low high text =
    narrowInteger low high text
        |> Result.mapError (\_ -> "Expecting " ++ what)


{-| A 64-bit integer map key in its canonical decimal form, within the range
of `width`.
-}
wideKey : String -> Width -> String -> Result String String
wideKey what width text =
    wideInteger width text
        |> Result.mapError (\_ -> "Expecting " ++ what ++ " " ++ widthRange width)


{-| Decode a map with `bool` keys as an association list, since Elm's `Bool`
is not `comparable` and so cannot key a `Dict`. proto3 JSON writes each key as
`"true"` or `"false"`; any other key fails. The pairs come in the object's key
order, and a map has at most two.

    Json.Decode.decodeString (boolMap string) """{"true":"on","false":"off"}"""
    -- Ok [ ( True, "on" ), ( False, "off" ) ]

-}
boolMap : Json.Decode.Decoder a -> Json.Decode.Decoder (List ( Bool, a ))
boolMap decoder =
    Json.Decode.keyValuePairs decoder
        |> Json.Decode.andThen
            (\pairs ->
                List.foldr
                    (\( key, entry ) result ->
                        Result.map2 (\bool rest -> ( bool, entry ) :: rest)
                            (boolKey key)
                            result
                    )
                    (Ok [])
                    pairs
                    |> fromResult
            )


boolKey : String -> Result String Bool
boolKey key =
    case key of
        "true" ->
            Ok True

        "false" ->
            Ok False

        _ ->
            Err "Expecting a bool map key (\"true\" or \"false\")"


fromResult : Result String a -> Json.Decode.Decoder a
fromResult result =
    case result of
        Ok decoded ->
            Json.Decode.succeed decoded

        Err problem ->
            Json.Decode.fail problem


{-| Decode a signed 32-bit integer (`int32`, `sint32`, `sfixed32`).

proto3 JSON writes these as numbers, and a parser must also accept a string
and exponent notation: `42`, `"42"`, `1e2` and `"1e2"` all decode, as does
`4.0`. A string takes the forms [`int64`](#int64) reads one in, so `"007"` is
7 and `"+5"` fails. A value with a fractional part fails, and so does one
outside the type's range, -2147483648 to 2147483647.

-}
int32 : Json.Decode.Decoder Int
int32 =
    boundedInt "an int32 (-2147483648 to 2147483647)" -2147483648 2147483647


{-| Decode an unsigned 32-bit integer (`uint32`, `fixed32`): the forms
[`int32`](#int32) accepts, within 0 to 4294967295.
-}
uint32 : Json.Decode.Decoder Int
uint32 =
    boundedInt "a uint32 (0 to 4294967295)" 0 4294967295


{-| A JSON number, or a JSON string that should hold one.
-}
type Numeric
    = NumberForm Float
    | StringForm String


numeric : Json.Decode.Decoder Numeric
numeric =
    Json.Decode.oneOf
        [ Json.Decode.map NumberForm Json.Decode.float
        , Json.Decode.map StringForm Json.Decode.string
        ]


{-| An integer in any form proto3 JSON allows for one, within `low` to
`high`: a number compared as a `Float`, which holds the bounds exactly, and a
string read as [`int64`](#int64) reads one.
-}
boundedInt : String -> Int -> Int -> Json.Decode.Decoder Int
boundedInt what low high =
    let
        outOfRange =
            Json.Decode.fail ("Expecting " ++ what)
    in
    numeric
        |> Json.Decode.andThen
            (\form ->
                case form of
                    NumberForm _ ->
                        case integral form of
                            Err problem ->
                                Json.Decode.fail problem

                            Ok number ->
                                if number < toFloat low || number > toFloat high then
                                    outOfRange

                                else
                                    Json.Decode.succeed (round number)

                    StringForm text ->
                        case narrowInteger low high text of
                            Ok int ->
                                Json.Decode.succeed int

                            Err OutOfRange ->
                                outOfRange

                            Err _ ->
                                Json.Decode.fail "Expecting an integer"
            )


{-| A 32-bit integer written as text, as [`int64`](#int64) reads a string,
within `low` to `high`.
-}
narrowInteger : Int -> Int -> String -> Result IntegerProblem Int
narrowInteger low high text =
    canonicalInteger text
        |> Result.andThen
            (\decimal ->
                case String.toInt decimal of
                    Just int ->
                        if int >= low && int <= high then
                            Ok int

                        else
                            Err OutOfRange

                    Nothing ->
                        Err NotDecimal
            )


{-| The integral value of a number, or of a string holding one in decimal or
exponent notation.
-}
integral : Numeric -> Result String Float
integral form =
    let
        number =
            case form of
                NumberForm given ->
                    Just given

                StringForm text ->
                    String.toFloat text

        notInteger =
            Err "Expecting an integer"
    in
    case number of
        Just given ->
            if isNaN given || isInfinite given || toFloat (round given) /= given then
                notInteger

            else
                Ok given

        Nothing ->
            notInteger


{-| Decode a 64-bit integer (`int64`, `uint64`, `sint64`, `fixed64`,
`sfixed64`) as its decimal string, since Elm's `Int` is exact only up to
2^53.

proto3 JSON writes these as strings, and a parser must accept either a string
or a number, in exponent notation too. The result is always the canonical
decimal string, with no leading zeros:

    "42", 42           --> "42"
    "1e3", "1.5e3"     --> "1000", "1500"
    1E2, "-2e0"        --> "100", "-2"
    "007", "-0"        --> "7", "0"

A value that is not an integer fails (`"4.2"`, `"1.5e0"`), and so does one
outside the type's range, -9223372036854775808 to 9223372036854775807
(`"9223372036854775808"`). Exponent notation is read as text, by moving the
decimal point, so a string keeps every digit. A number is read as the exact
value of the double JavaScript's JSON parser made of it, as a runtime with
big integers reads it: `-9223372036854775808` and `9223372036854774784` keep
every digit. A number no double holds was rounded by that parser before this
decoder saw it, and reads as the rounded value: `9223372036854775807` as
2^63, which is out of range. Write such a value as a string.

-}
int64 : Json.Decode.Decoder String
int64 =
    wide Signed


{-| A 64-bit integer as its canonical decimal string, within the range of
`width`.
-}
wide : Width -> Json.Decode.Decoder String
wide width =
    Json.Decode.oneOf
        [ Json.Decode.string
        , Json.Decode.map exactDecimal Json.Decode.int
        ]
        |> Json.Decode.andThen
            (\text ->
                case wideInteger width text of
                    Ok decimal ->
                        Json.Decode.succeed decimal

                    Err NotDecimal ->
                        Json.Decode.fail "Expecting a decimal integer"

                    Err NotInteger ->
                        Json.Decode.fail "Expecting an integer"

                    Err OutOfRange ->
                        Json.Decode.fail ("Expecting " ++ widthName width ++ " " ++ widthRange width)
            )


{-| The exact decimal value of an integral JSON number. `String.fromInt`
writes JavaScript's shortest form, which past 2^53 can end in zeros the
value does not have (9223372036854774784 as `"9223372036854775000"`). From
2^53 to 2^64 the magnitude is split into 32-bit halves and then into a count
of millions and a remainder, every step exact in a double since each value
stays below 2^53; 2^64 and past, out of every 64-bit type's range, keep the
shortest form, which the range check refuses.
-}
exactDecimal : Int -> String
exactDecimal number =
    let
        magnitude =
            abs number
    in
    if magnitude <= 9007199254740992 || toFloat magnitude >= 1.8446744073709552e19 then
        String.fromInt number

    else
        let
            high =
                floor (toFloat magnitude / 4294967296)

            low =
                magnitude - high * 4294967296

            -- 4294967296 is 4294 millions and 967296.
            belowMillions =
                high * 967296 + low

            ones =
                modBy 1000000 belowMillions

            millions =
                high * 4294 + round (toFloat (belowMillions - ones) / 1000000)

            sign =
                if number < 0 then
                    "-"

                else
                    ""
        in
        sign ++ String.fromInt millions ++ String.padLeft 6 '0' (String.fromInt ones)


{-| The 64-bit integer types' two ranges.
-}
type Width
    = Signed
    | Unsigned


widthName : Width -> String
widthName width =
    case width of
        Signed ->
            "an int64"

        Unsigned ->
            "a uint64"


widthRange : Width -> String
widthRange width =
    case width of
        Signed ->
            "(-9223372036854775808 to 9223372036854775807)"

        Unsigned ->
            "(0 to 18446744073709551615)"


{-| Why text is not an integer of a type.
-}
type IntegerProblem
    = NotDecimal
    | NotInteger
    | OutOfRange


{-| The canonical decimal form of a 64-bit integer written as text, within
the range of `width`. The digits are compared with the bound's as text, by
length and then digit by digit, since an `Int` is exact only to 2^53.
-}
wideInteger : Width -> String -> Result IntegerProblem String
wideInteger width text =
    canonicalInteger text
        |> Result.andThen
            (\decimal ->
                let
                    inRange =
                        case ( width, String.startsWith "-" decimal ) of
                            ( Signed, True ) ->
                                atMost "9223372036854775808" (String.dropLeft 1 decimal)

                            ( Signed, False ) ->
                                atMost "9223372036854775807" decimal

                            ( Unsigned, True ) ->
                                False

                            ( Unsigned, False ) ->
                                atMost "18446744073709551615" decimal
                in
                if inRange then
                    Ok decimal

                else
                    Err OutOfRange
            )


{-| Whether the digits of a canonical natural number (no leading zeros) are at
most `bound`'s.
-}
atMost : String -> String -> Bool
atMost bound digits =
    String.length digits
        < String.length bound
        || (String.length digits == String.length bound && digits <= bound)


{-| The canonical decimal form of an integer written as text in decimal or
exponent notation (`"-1.5e3"` is `"-1500"`), found by moving the decimal point
rather than through a `Float`, which would round past 2^53. One of more than
20 digits, past every 64-bit integer, is `OutOfRange` without being written
out, so an exponent cannot ask for a string of any length.
-}
canonicalInteger : String -> Result IntegerProblem String
canonicalInteger text =
    let
        ( sign, unsigned ) =
            if String.startsWith "-" text then
                ( "-", String.dropLeft 1 text )

            else
                ( "", text )
    in
    case scientific unsigned of
        Nothing ->
            Err NotDecimal

        Just { digits, point } ->
            let
                leading =
                    leadingCount '0' digits

                significant =
                    String.dropLeft leading digits

                -- The point counted from the first significant digit.
                shifted =
                    point - leading

                kept =
                    String.dropRight (trailingCount '0' significant) significant
            in
            if String.isEmpty kept then
                Ok "0"

            else if String.length kept > shifted then
                Err NotInteger

            else if shifted > 20 then
                Err OutOfRange

            else
                Ok (sign ++ kept ++ String.repeat (shifted - String.length kept) "0")


{-| An unsigned number in decimal or exponent notation (`1`, `1.5`, `15e-1`,
`1.5E+0`) as its digits and the position of the decimal point among them,
which may lie outside them.
-}
scientific : String -> Maybe { digits : String, point : Int }
scientific text =
    let
        -- A low surrogate without its high half is read with the unit
        -- before it, a digit perhaps, as one character two units long.
        allDigits part =
            not (String.isEmpty part) && String.all (\char -> Char.isDigit char && String.length (String.fromChar char) == 1) part

        exponentOf part =
            if allDigits (String.dropLeft 1 part) && (String.startsWith "+" part || String.startsWith "-" part) then
                String.toInt part

            else if allDigits part then
                String.toInt part

            else
                Nothing

        ( mantissa, exponent ) =
            case String.split "e" (String.toLower text) of
                [ whole ] ->
                    ( whole, Just 0 )

                [ whole, power ] ->
                    ( whole, exponentOf power )

                _ ->
                    ( "", Nothing )

        parts =
            case String.split "." mantissa of
                [ whole ] ->
                    Just ( whole, "" )

                [ whole, fraction ] ->
                    if allDigits fraction then
                        Just ( whole, fraction )

                    else
                        Nothing

                _ ->
                    Nothing
    in
    case ( parts, exponent ) of
        ( Just ( whole, fraction ), Just power ) ->
            if allDigits whole then
                Just { digits = whole ++ fraction, point = String.length whole + power }

            else
                Nothing

        _ ->
            Nothing


{-| How many times `char` repeats at the start of `text`, in one pass.
-}
leadingCount : Char -> String -> Int
leadingCount char text =
    String.foldl
        (\c ( count, counting ) ->
            if counting && c == char then
                ( count + 1, True )

            else
                ( count, False )
        )
        ( 0, True )
        text
        |> Tuple.first


{-| How many times `char` repeats at the end of `text`, in one pass.
-}
trailingCount : Char -> String -> Int
trailingCount char text =
    String.foldr
        (\c ( count, counting ) ->
            if counting && c == char then
                ( count + 1, True )

            else
                ( count, False )
        )
        ( 0, True )
        text
        |> Tuple.first


{-| Decode a 64-bit integer as an `Int`, for code generated with the
`int64=int` option or for a field marked `[jstype = JS_NUMBER]`.

It accepts a JSON number or a string, in decimal or exponent notation, as
proto3 JSON requires (`42`, `"42"`, `"4.2e1"`), and fails on a value that is not an integer or lies outside ±9007199254740991,
where Elm's `Int` stops being exact; see
[`Proto.Int64.toInt`](Proto-Int64#toInt). A number outside that range
fails too, whether a double holds it exactly or JavaScript's JSON parser
rounded it.

-}
int64AsInt : Json.Decode.Decoder Int
int64AsInt =
    numeric |> Json.Decode.andThen int64Form


{-| Decode an unsigned 64-bit integer (`uint64`, `fixed64`) as its decimal
string: the forms [`int64`](#int64) accepts, within 0 to 18446744073709551615
(2^64 - 1).
-}
uint64 : Json.Decode.Decoder String
uint64 =
    wide Unsigned


{-| Decode an unsigned 64-bit integer as an `Int`, under the `int64=int`
option: the forms [`int64AsInt`](#int64AsInt) accepts, from 0 up to
the largest `Int` that is exact, 9007199254740991.
-}
uint64AsInt : Json.Decode.Decoder Int
uint64AsInt =
    int64AsInt
        |> Json.Decode.andThen
            (\number ->
                if number < 0 then
                    Json.Decode.fail "Expecting a uint64 (0 or more)"

                else
                    Json.Decode.succeed number
            )


int64Form : Numeric -> Json.Decode.Decoder Int
int64Form form =
    let
        outOfRange =
            Json.Decode.fail
                "Expecting an integer from -9007199254740991 to 9007199254740991, the 64-bit integers an Elm Int holds exactly"
    in
    case form of
        NumberForm number ->
            case integral form of
                Err problem ->
                    Json.Decode.fail problem

                Ok _ ->
                    if abs number > 9007199254740991 then
                        outOfRange

                    else
                        Json.Decode.succeed (round number)

        StringForm text ->
            case canonicalInteger text of
                Err NotDecimal ->
                    Json.Decode.fail "Expecting a decimal integer"

                Err NotInteger ->
                    Json.Decode.fail "Expecting an integer"

                Err OutOfRange ->
                    outOfRange

                Ok decimal ->
                    case Proto.Int64.toInt decimal of
                        Just int ->
                            Json.Decode.succeed int

                        Nothing ->
                            outOfRange


{-| Decode a `double`. proto3 JSON writes a finite value as a number and the
others as the strings `"NaN"`, `"Infinity"` and `"-Infinity"`; a parser must
also accept a finite value written as a string, such as `"1.5"`.

A number past a double's range, such as `1e999`, fails: JavaScript's JSON
parser reads it as an infinity, which proto3 JSON writes only as a string.

-}
double : Json.Decode.Decoder Float
double =
    Json.Decode.oneOf
        [ Json.Decode.map Ok Json.Decode.float
        , Json.Decode.map Err Json.Decode.string
        ]
        |> Json.Decode.andThen (floatIn "a double" (\_ -> True))


{-| Decode a `float`, as [`double`](#double) decodes a `double`, and fail on a
finite value whose magnitude is past the largest `float`,
3.4028234663852886e38. A value within it is kept as it arrived, not rounded to
the nearest `float`.
-}
float : Json.Decode.Decoder Float
float =
    Json.Decode.oneOf
        [ Json.Decode.map Ok Json.Decode.float
        , Json.Decode.map Err Json.Decode.string
        ]
        |> Json.Decode.andThen (floatIn "a float" (\number -> abs number <= maxFloat32))


maxFloat32 : Float
maxFloat32 =
    3.4028234663852886e38


{-| A number, or the string it was written as, if it is finite and `fits`, or
the string is one of the names of the values a number cannot write.
-}
floatIn : String -> (Float -> Bool) -> Result String Float -> Json.Decode.Decoder Float
floatIn kind fits written =
    let
        checked number =
            if isInfinite number || not (fits number) then
                Json.Decode.fail ("Expecting " ++ kind ++ ", but got a number past its range")

            else
                Json.Decode.succeed number
    in
    case written of
        Ok number ->
            checked number

        Err "NaN" ->
            Json.Decode.succeed (0 / 0)

        Err "Infinity" ->
            Json.Decode.succeed (1 / 0)

        Err "-Infinity" ->
            Json.Decode.succeed -(1 / 0)

        Err text ->
            case String.toFloat text of
                Just number ->
                    if isNaN number then
                        Json.Decode.fail "Expecting a number"

                    else
                        checked number

                Nothing ->
                    Json.Decode.fail "Expecting a number"


{-| Decode `bytes`, which proto3 JSON writes as a base64 string, as that
string, kept exactly as it arrived (not normalised to one alphabet or
padding).

The string must be base64, as proto3 JSON parsers accept it: the standard
alphabet (`A`–`Z`, `a`–`z`, `0`–`9`, `+`, `/`) or the URL-safe one (`-` and
`_` in place of `+` and `/`), not both in one string, with or without `=`
padding. Anything else fails: another character, a length no base64 text has,
or padding that does not fit the length.

    Json.Decode.decodeString bytes "\"aGk=\"" -- Ok "aGk="

    Json.Decode.decodeString bytes "\"aGk\"" -- Ok "aGk"

    Json.Decode.decodeString bytes "\"a\"" -- Err ...

-}
bytes : Json.Decode.Decoder String
bytes =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                if isBase64 text then
                    Json.Decode.succeed text

                else
                    Json.Decode.fail "Expecting base64 (standard or URL-safe, padding optional)"
            )


isBase64 : String -> Bool
isBase64 text =
    let
        padding =
            trailingPadding text

        body =
            String.dropRight padding text

        partial =
            modBy 4 (String.length body)
    in
    -- The padding is counted and dropped natively; `String.all` then reads
    -- the body from its end, which `isBase64Char` makes safe (see there).
    (padding == 0 || (partial /= 0 && padding == 4 - partial))
        && (partial /= 1)
        && String.all isBase64Char body
        && not (bothAlphabets body)


{-| How many `=` end `text`, up to 3: more than 2 is never base64.
-}
trailingPadding : String -> Int
trailingPadding text =
    if String.endsWith "==" text then
        if String.endsWith "===" text then
            3

        else
            2

    else if String.endsWith "=" text then
        1

    else
        0


{-| Whether base64 text mixes the standard alphabet's `+` or `/` with the
URL-safe one's `-` or `_`.
-}
bothAlphabets : String -> Bool
bothAlphabets body =
    (String.contains "+" body || String.contains "/" body) && (String.contains "-" body || String.contains "_" body)


{-| A character of either base64 alphabet. elm/core's `String.all` reads a
string from its end and takes a low surrogate without its high half together
with the code unit before it, a letter perhaps, as one character two units
long; at the start of the text, with what lies before the string, where
reading on would never return. Its length refuses it.
-}
isBase64Char : Char -> Bool
isBase64Char char =
    let
        code =
            Char.toCode char
    in
    String.length (String.fromChar char) == 1 && ((code >= 0x61 && code <= 0x7A) || (code >= 0x41 && code <= 0x5A) || (code >= 0x30 && code <= 0x39) || char == '+' || char == '/' || char == '-' || char == '_')


{-| Decode `bytes`, which proto3 JSON writes as a base64 string, as the bytes
it holds. It accepts what [`bytes`](#bytes) accepts.

    Json.Decode.decodeString bytesAsBytes "\"aGk=\"" |> Result.map Bytes.width -- Ok 2

    Json.Decode.decodeString bytesAsBytes "\"a\"" -- Err ...

-}
bytesAsBytes : Json.Decode.Decoder Bytes
bytesAsBytes =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                case Proto.Bytes.fromBase64 text of
                    Just decoded ->
                        Json.Decode.succeed decoded

                    Nothing ->
                        Json.Decode.fail "Expecting base64 (standard or URL-safe, padding optional)"
            )


{-| Decode a `google.protobuf.Timestamp`, an RFC 3339 string, exactly; see
[`Proto.Timestamp.fromString`](Proto-Timestamp#fromString).
-}
timestamp : Json.Decode.Decoder Timestamp
timestamp =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                case Proto.Timestamp.fromString text of
                    Just instant ->
                        Json.Decode.succeed instant

                    Nothing ->
                        Json.Decode.fail "Expecting an RFC 3339 timestamp"
            )


{-| Decode a `google.protobuf.Duration`, such as `"1.5s"`; see
[`Proto.Duration.fromString`](Proto-Duration#fromString).
-}
duration : Json.Decode.Decoder Duration
duration =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                case Proto.Duration.fromString text of
                    Just decoded ->
                        Json.Decode.succeed decoded

                    Nothing ->
                        Json.Decode.fail "Expecting a duration such as \"1.5s\""
            )


{-| Decode a `google.protobuf.FieldMask` into its paths. proto3 JSON writes a
mask as one string, the paths joined by commas, each field name in
lowerCamelCase; the paths come back with proto field names, as a server
expects them:

    Json.Decode.decodeString fieldMask "\"displayName,author.emailAddress\""
    -- Ok [ "display_name", "author.email_address" ]

The empty string is the empty mask. A path with an `_` fails: lowerCamelCase
has none, so it can only be a proto field name, which proto3 JSON does not
write here.

-}
fieldMask : Json.Decode.Decoder (List String)
fieldMask =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                if String.isEmpty text then
                    Json.Decode.succeed []

                else if String.contains "_" text then
                    Json.Decode.fail "Expecting a FieldMask of lowerCamelCase paths"

                else
                    String.split "," text
                        |> List.map FieldMask.fromJsonPath
                        |> Json.Decode.succeed
            )


{-| Decode a `google.protobuf.Empty`: any JSON object, usually `{}`. A field
of it reads as `()` when absent or `null` too, so its presence is not kept.
-}
empty : Json.Decode.Decoder ()
empty =
    Json.Decode.value
        |> Json.Decode.andThen
            (\json ->
                if isObject json then
                    Json.Decode.succeed ()

                else
                    notAnObject
            )


{-| Decode the enum `google.protobuf.NullValue`, held as `()`: its one value,
`NULL_VALUE`, is written `null`, and a parser also accepts its name and number,
as it does for any enum ([`enum`](#enum)).
-}
nullValue : Json.Decode.Decoder ()
nullValue =
    Json.Decode.nullable (enum "NullValue" () [ ( "NULL_VALUE", 0, () ) ])
        |> Json.Decode.map (\_ -> ())


{-| Decode a `google.protobuf.Struct`, a JSON object, into its members. Any
other JSON, such as an array, fails with elm/json's `Expecting an OBJECT`,
and an object nested more than 100 deep with "Expecting messages nested at
most 100 deep", which does not say where inside it the limit was passed.

    Json.Decode.decodeString struct """{"a":1}"""
    -- Ok (Dict.fromList [ ( "a", ValueNumber 1 ) ])

-}
struct : Json.Decode.Decoder (Dict.Dict String Proto.Value.Value)
struct =
    nestedStruct 0


{-| [`struct`](#struct) read at a nesting depth, by a message that nests: the
object is one level deeper.
-}
nestedStruct : Int -> Json.Decode.Decoder (Dict.Dict String Proto.Value.Value)
nestedStruct depth =
    if depth < Depth.limit then
        ValueJson.read (Json.Decode.dict (valueNode (depth + 1))) notAnObjectOrTooDeep

    else
        notAnObjectOrTooDeep


{-| The failure of a `Struct` that did not read: elm/json's for JSON that is
not an object, and the depth limit's for an object, since an object fails
only by nesting too deeply.
-}
notAnObjectOrTooDeep : Json.Decode.Decoder a
notAnObjectOrTooDeep =
    Json.Decode.dict (Json.Decode.succeed ()) |> Json.Decode.andThen (\_ -> Depth.tooDeep)


{-| Decode a `google.protobuf.ListValue`, a JSON array, into its elements. Any
other JSON, such as an object, fails with elm/json's `Expecting a LIST`, and
an array nested more than 100 deep as [`struct`](#struct) says.
-}
listValue : Json.Decode.Decoder (List Proto.Value.Value)
listValue =
    nestedListValue 0


{-| [`listValue`](#listValue) read at a nesting depth.
-}
nestedListValue : Int -> Json.Decode.Decoder (List Proto.Value.Value)
nestedListValue depth =
    if depth < Depth.limit then
        ValueJson.read (Json.Decode.list (valueNode (depth + 1))) notAListOrTooDeep

    else
        notAListOrTooDeep


{-| The failure of a `ListValue` that did not read, as
`notAnObjectOrTooDeep` is a `Struct`'s.
-}
notAListOrTooDeep : Json.Decode.Decoder a
notAListOrTooDeep =
    Json.Decode.list (Json.Decode.succeed ()) |> Json.Decode.andThen (\_ -> Depth.tooDeep)


{-| Decode a `google.protobuf.Value`: any JSON, its arrays and objects
nested at most 100 deep. Deeper JSON fails with "Expecting messages nested at
most 100 deep", the failure of messages nested too deeply, since the levels
of both count against one limit (design section 3.5). The same decoder as
[`Proto.Value.decoder`](Proto-Value#decoder).

    Json.Decode.decodeString value """{"a":[1,"x",null]}"""
    -- Ok (ValueStruct (Dict.fromList [ ( "a", ValueList [ ValueNumber 1, ValueString "x", ValueNull ] ) ]))

-}
value : Json.Decode.Decoder Proto.Value.Value
value =
    nestedValue 0


{-| [`value`](#value) read at a nesting depth, by a message that nests: its
arrays and objects are a level deeper each.
-}
nestedValue : Int -> Json.Decode.Decoder Proto.Value.Value
nestedValue depth =
    ValueJson.read (valueNode depth) Depth.tooDeep


{-| `Proto.Value`'s table of decoders by depth, built here too, so that a
program reading these types through generated code holds one table.
-}
valueNode : Int -> Json.Decode.Decoder Proto.Value.Value
valueNode depth =
    Array.get depth valueDecoders |> Maybe.withDefault Depth.tooDeep


valueDecoders : Array (Json.Decode.Decoder Proto.Value.Value)
valueDecoders =
    Array.initialize (Depth.limit + 1) (ValueJson.level valueKinds valueNode)


valueKinds : ValueJson.Kinds Proto.Value.Value
valueKinds =
    { null = Proto.Value.ValueNull
    , bool = Proto.Value.ValueBool
    , number = Proto.Value.ValueNumber
    , string = Proto.Value.ValueString
    , list = Proto.Value.ValueList
    , object = Proto.Value.ValueStruct
    }


{-| Decode a `google.protobuf.Any` into one holding its message's protobuf
binary, which the registry's entry for its type converts the JSON to: an
object with `"@type"`, holding the message's fields or, for a well-known type
with a JSON form of its own, `"value"`. An object without `"@type"` fails, but
for `{}`, the empty `Any`, and so does one whose `"@type"` is not a type URL:
it must hold a `/` with a type name after the last one. As protobuf's own
JSON readers do, it fails for a type the registry has no entry for, naming
its type URL (register the type, see [`Proto.Registry`](Proto-Registry)),
unless the registry is [lenient](Proto-Registry#lenient): then the `Any`
holds the JSON alone. It fails for JSON that is not its message, lenient
or not.
-}
any : Registry -> Json.Decode.Decoder Any
any (InternalRegistry.Registry leniency depth entries) =
    anyParts
        |> Json.Decode.andThen
            (\parts ->
                case parts of
                    Just ( url, messageJson ) ->
                        let
                            read readLeniency =
                                InternalRegistry.toBytes (InternalRegistry.Registry readLeniency depth entries) (InternalAny.nameOf url) messageJson

                            json =
                                Json.Decode.succeed (InternalAny.Any url (InternalAny.Json messageJson))
                        in
                        if leniency == InternalRegistry.Checking then
                            -- Only whether the read succeeds is kept, and held as
                            -- JSON this `Any` adds nothing to the binary around it.
                            case read InternalRegistry.Checking of
                                Just (Err problem) ->
                                    notItsMessage url problem

                                _ ->
                                    json

                        else
                            case read InternalRegistry.Strict of
                                Just (Ok base64) ->
                                    Json.Decode.succeed (InternalAny.Any url (InternalAny.Binary base64))

                                Just (Err problem) ->
                                    if leniency == InternalRegistry.Lenient then
                                        -- Read leniently, it may hold an `Any` its binary
                                        -- would lose: it is held as JSON alone. That read
                                        -- is a check, its binary dropped.
                                        case read InternalRegistry.Checking of
                                            Just (Ok _) ->
                                                json

                                            _ ->
                                                notItsMessage url problem

                                    else
                                        notItsMessage url problem

                                Nothing ->
                                    if leniency == InternalRegistry.Lenient then
                                        json

                                    else
                                        Json.Decode.fail "Expecting an Any of a type the registry has"

                    Nothing ->
                        Json.Decode.succeed InternalAny.empty
            )


{-| The failure of an `Any` whose JSON is not the message its type URL names.
A JSON failure is failed again where it happened, under the `Any`, so that its
path and its own text stand as any other failure's do; anything else says
which type it was.
-}
notItsMessage : String -> Error -> Json.Decode.Decoder a
notItsMessage url problem =
    case problem of
        Proto.Error.BadJson inner ->
            if InternalAny.hasJsonForm url then
                Json.Decode.field "value" (failAgain inner)

            else
                failAgain inner

        _ ->
            Json.Decode.fail ("Expecting an Any of " ++ quote url ++ " to hold that message")


{-| A decoder that fails as `error` did, on the same JSON.
-}
failAgain : Json.Decode.Error -> Json.Decode.Decoder a
failAgain error =
    case error of
        Json.Decode.Field name inner ->
            Json.Decode.field name (failAgain inner)

        Json.Decode.Index index inner ->
            Json.Decode.index index (failAgain inner)

        Json.Decode.OneOf ways ->
            Json.Decode.oneOf (List.map failAgain ways)

        Json.Decode.Failure text _ ->
            Json.Decode.fail text


{-| An `Any` object's type URL and its message's JSON, or `Nothing` for `{}`.
-}
anyParts : Json.Decode.Decoder (Maybe ( String, Json.Encode.Value ))
anyParts =
    Json.Decode.keyValuePairs Json.Decode.value
        |> Json.Decode.andThen anyFromPairs


anyFromPairs : List ( String, Json.Encode.Value ) -> Json.Decode.Decoder (Maybe ( String, Json.Encode.Value ))
anyFromPairs pairs =
    case ( pairValue "@type" pairs, pairs ) of
        ( Nothing, [] ) ->
            Json.Decode.succeed Nothing

        ( Nothing, _ ) ->
            Json.Decode.fail "Expecting an Any: an object with \"@type\""

        ( Just found, _ ) ->
            case Json.Decode.decodeValue Json.Decode.string found of
                Err _ ->
                    Json.Decode.fail "Expecting an Any whose \"@type\" is a string"

                Ok url ->
                    if not (isTypeUrl url) then
                        Json.Decode.fail "Expecting an Any whose \"@type\" is a type URL, such as \"type.googleapis.com/notes.v1.Note\""

                    else if InternalAny.hasJsonForm url then
                        case pairValue "value" pairs of
                            Just json ->
                                Json.Decode.succeed (Just ( url, json ))

                            Nothing ->
                                Json.Decode.fail ("Expecting an Any of " ++ InternalAny.nameOf url ++ " to hold \"value\"")

                    else
                        pairs
                            |> List.filter (\( key, _ ) -> key /= "@type")
                            |> Json.Encode.object
                            |> Tuple.pair url
                            |> Just
                            |> Json.Decode.succeed


{-| A type URL, as proto3 JSON requires `"@type"` to hold one: a `/` with a
type name after the last one.
-}
isTypeUrl : String -> Bool
isTypeUrl url =
    String.contains "/" url && not (String.endsWith "/" url)


{-| The value under `key` among a JSON object's pairs.
-}
pairValue : String -> List ( String, a ) -> Maybe a
pairValue key pairs =
    case pairs of
        [] ->
            Nothing

        ( k, v ) :: rest ->
            if k == key then
                Just v

            else
                pairValue key rest



-- MESSAGES THAT NEST


{-| The decoder at a depth of a message on a cycle, the outermost message at 1,
from the decoder `build` makes for a depth. `memo build` makes
the decoders for depths 1 to 100 once, so applied in a top-level value, as
generated code applies it, it makes them once per program, and a read looks
its decoder up; past 100 the decoder fails.

    decodeNestedNode =
        Proto.Json.Decode.memo (\depth -> ...)

-}
memo : (Int -> Json.Decode.Decoder a) -> Int -> Json.Decode.Decoder a
memo build =
    let
        table =
            Array.initialize Depth.limit (\index -> build (index + 1))
    in
    \depth ->
        case Array.get (depth - 1) table of
            Just decoder ->
                decoder

            Nothing ->
                Depth.tooDeep


{-| A message on no cycle that nests and takes the registry, read by a message
at `depth`: its decoder one level deeper, built from `build` when this is, or
past 100 levels failing. A holder's decoder that takes the registry is built
as it is read, so this builds the message's once per read of its holder.

    Proto.Json.Decode.deeper depth (decodeNestedNoteWith types)

-}
deeper : Int -> (Int -> Json.Decode.Decoder a) -> Json.Decode.Decoder a
deeper depth build =
    if depth < Depth.limit then
        build (depth + 1)

    else
        Depth.tooDeep


{-| A message that nests, read by a message at `depth`: its decoder one level
deeper, built from `build` as the value is read, or past 100 levels failing.
A message on a cycle that takes the registry is read so, since its decoder
cannot be built before the registry is given; so is a message on no cycle
that takes none, whose decoder built when its holder's is would be built
once for every path to it.

    deeperLazy depth (decodeNestedNodeWith types)

    deeperLazy depth decodeNestedNote

-}
deeperLazy : Int -> (Int -> Json.Decode.Decoder a) -> Json.Decode.Decoder a
deeperLazy depth build =
    Json.Decode.lazy
        (\_ ->
            if depth < Depth.limit then
                build (depth + 1)

            else
                Depth.tooDeep
        )


{-| [`any`](#any) for an `Any` held by a message at `depth`: the `Any`, and what it holds, count on from there.
-}
nestedAny : Int -> Registry -> Json.Decode.Decoder Any
nestedAny depth registry =
    any (InternalRegistry.atLeast depth registry)


{-| The depth a message that takes the registry starts counting from when it
is read with it: 1 at the top, as for any message, or, inside an `Any`, the
depth the read has reached there, so the message counts on from the `Any`.

    decodeNoteWith types =
        decodeNestedNoteWith types (registryDepth types)

-}
registryDepth : Registry -> Int
registryDepth (InternalRegistry.Registry _ depth _) =
    max 1 depth
