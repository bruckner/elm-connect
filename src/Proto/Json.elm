{-| The proto3 JSON helpers that code generated by elm-connect calls.
Application code rarely needs them directly.

A decoder is named for what it reads (`int64`, `timestamp`), a value's
encoder is `encode` and that name (`encodeInt64`), and a field's encoder,
which gives `Nothing` to leave the field out, ends in `Field`
(`repeatedField`).


# Fields

@docs field, fieldEither, valueField, valueFieldEither, emptyMessage


# Encoding fields

A generated encoder leaves out every field at its proto3 default, as protobuf's
own JSON writers do: a field without presence at its zero value, a field with
presence (`Maybe`) when `Nothing`, a repeated or map field when empty. A parser
reads a missing field as its default, so nothing is lost.

    encodeNote : Note -> Value
    encodeNote value =
        objectOfFields
            [ ( "title", implicitField "" Json.Encode.string value.title )
            , ( "score", implicitFloatField value.score )
            , ( "author", Maybe.map encodeAuthor value.author )
            , ( "tags", repeatedField Json.Encode.string value.tags )
            ]

@docs objectOfFields
@docs implicitField, implicitFloatField, implicitBytesField, repeatedField, dictField, boolMapField


# Oneofs

@docs oneof, members, Member, member, memberEither
@docs emptyMember, emptyMemberEither, valueMember, valueMemberEither


# Enums

@docs enum, enumOrZero


# Maps

@docs int32Dict, uint32Dict, int64Dict, uint64Dict, boolMap, encodeBoolMap


# 32-bit integers

Encode them with `Json.Encode.int`.

@docs int32, uint32


# 64-bit integers

By default a 64-bit integer is held as its decimal string. Code generated with
the `int64=int` option, and fields marked `[jstype = JS_NUMBER]`, hold it as an
`Int` instead.

@docs int64, uint64, encodeInt64
@docs int64AsInt, uint64AsInt, encodeInt64AsInt


# Floating point

@docs float, encodeFloat


# Bytes

By default a `bytes` field is held as its base64 text. Code generated with the
`bytes=bytes` option holds it as elm/bytes' `Bytes` instead; see
[`Proto.Bytes`](Proto-Bytes) for what `==` does with those.

@docs bytes, encodeBytes
@docs bytesAsBytes, encodeBytesAsBytes


# Well-known types

`Value` is any JSON, held as a `Json.Encode.Value`: a field of it decodes
with [`valueField`](#valueField), and a list or map of it, or a oneof member,
with `Json.Decode.value`. The wrapper types (`Int32Value` and the rest) use
their scalar's helpers.

@docs timestamp, encodeTimestamp
@docs duration, encodeDuration
@docs fieldMask, encodeFieldMask
@docs empty, encodeEmpty
@docs struct, encodeStruct
@docs listValue, encodeListValue
@docs any, encodeAny

-}

import Bytes exposing (Bytes)
import Dict
import Json.Decode exposing (Decoder)
import Json.Encode exposing (Value)
import Proto.Any exposing (Any)
import Proto.Bytes
import Proto.Duration exposing (Duration)
import Proto.Int64
import Proto.Internal.Any as InternalAny exposing (Payload(..))
import Proto.Timestamp
import Time


{-| Decode one field of a message in a decoding pipeline. A missing key or a
JSON `null` gives the default, the field's proto3 zero value; any other value
must satisfy the decoder.

    type alias Note =
        { title : String, stars : Int }

    decodeNote : Decoder Note
    decodeNote =
        Json.Decode.succeed Note
            |> field "title" "" Json.Decode.string
            |> field "stars" 0 int32

The value being decoded must be a JSON object.

The default says what absence means, so one step serves every field shape: a
field with presence (a message-typed or proto3 `optional` field) defaults to
`Nothing` and maps its decoder with `Just`, a repeated field defaults to `[]`
and decodes with `Json.Decode.list`.

    |> field "author" Nothing (Json.Decode.map Just decodeAuthor)
    |> field "tags" [] (Json.Decode.list Json.Decode.string)

-}
field : String -> a -> Decoder a -> Decoder (a -> b) -> Decoder b
field name default decoder =
    Json.Decode.map2 (|>) (valueAt [ name ] default decoder)


{-| [`field`](#field) for a field whose JSON name differs from its proto name:
the JSON name first, then the proto name. proto3 JSON parsers accept either
key, but not both: an object holding both fails, even when one of them is
`null`, as protobuf's own parsers reject a duplicate field.

    |> fieldEither "displayName" "display_name" "" Json.Decode.string

-}
fieldEither : String -> String -> a -> Decoder a -> Decoder (a -> b) -> Decoder b
fieldEither jsonName protoName default decoder =
    Json.Decode.map2 (|>) (valueAt (spellings jsonName protoName) default decoder)


{-| Decode a field of type `google.protobuf.Value`, held as a
`Maybe Json.Encode.Value`. A missing key gives `Nothing`. Any value under the
key gives `Just` it, `null` included: `null` is one of a `Value`'s own values,
so a field holding it is set, as protobuf's own parsers read it.

    type alias Setting =
        { name : String, value : Maybe Json.Encode.Value }

    decodeSetting : Decoder Setting
    decodeSetting =
        Json.Decode.succeed Setting
            |> field "name" "" Json.Decode.string
            |> valueField "value"

To encode one, `Nothing` leaves the field out and `Just` writes its JSON:

    objectOfFields [ ( "value", setting.value ) ]

-}
valueField : String -> Decoder (Maybe Value -> b) -> Decoder b
valueField name =
    valueFieldEither name name


{-| [`valueField`](#valueField) for a field whose JSON name differs from its
proto name: the JSON name first, then the proto name, as in
[`fieldEither`](#fieldEither).
-}
valueFieldEither : String -> String -> Decoder (Maybe Value -> b) -> Decoder b
valueFieldEither jsonName protoName =
    Json.Decode.map2 (|>) (jsonAt (spellings jsonName protoName))


{-| The JSON under whichever of `names`, the spellings of one field, the object
holds, `null` included; `Nothing` when it holds none of them.
-}
jsonAt : List String -> Decoder (Maybe Value)
jsonAt names =
    Json.Decode.value
        |> Json.Decode.andThen
            (\object_ ->
                case spelledAs names object_ of
                    NotAnObject ->
                        notAnObject

                    Spelled (Err problem) ->
                        Json.Decode.fail problem

                    Spelled (Ok found) ->
                        Json.Decode.succeed (Maybe.map Tuple.second found)
            )


{-| Decode a message without fields: any JSON object, usually `{}`, whatever
its keys. Anything else fails, as it does for a message with fields.

    decodePing : Decoder Ping
    decodePing =
        emptyMessage

-}
emptyMessage : Decoder {}
emptyMessage =
    Json.Decode.map (\() -> {}) empty


{-| The value under whichever of `names`, the spellings of one field, the
object holds, decoded; `default` when it holds none of them or holds `null`.
-}
valueAt : List String -> a -> Decoder a -> Decoder a
valueAt names default decoder =
    Json.Decode.value
        |> Json.Decode.andThen
            (\object_ ->
                case spelledAs names object_ of
                    NotAnObject ->
                        notAnObject

                    Spelled (Err problem) ->
                        Json.Decode.fail problem

                    Spelled (Ok Nothing) ->
                        Json.Decode.succeed default

                    Spelled (Ok (Just ( name, raw ))) ->
                        if isNull raw then
                            Json.Decode.succeed default

                        else
                            Json.Decode.field name decoder
            )


{-| The keys a field may be written under: its JSON name, then its proto name
when that differs.
-}
spellings : String -> String -> List String
spellings jsonName protoName =
    if jsonName == protoName then
        [ jsonName ]

    else
        [ jsonName, protoName ]


{-| What a JSON value holds of one field: nothing when it is not an object;
otherwise which of the field's spellings it holds, with its value, or an error
naming them when it holds more than one.
-}
type Spelled
    = NotAnObject
    | Spelled (Result String (Maybe ( String, Value )))


{-| Which of `names`, the spellings of one field, the value holds.

`Json.Decode.field` finds a key with JavaScript's `in`, which takes constant
time, so a message of F fields costs O(F) to decode rather than reading the
whole object once per field. `in` also finds what an object inherits, which
for a JSON object is only `Object.prototype`'s properties, so a spelling that
names one of those is looked up among the object's own keys instead, as
`Json.Decode.dict` lists them, which takes time in their number. And `in`
finds an array's `length` and methods, so a key found is a field only when
the JSON is not an array.

-}
spelledAs : List String -> Value -> Spelled
spelledAs names json =
    case names of
        [ name ] ->
            if isInherited name then
                spelledAsAny names json

            else
                -- One spelling, as most fields have: the general case below
                -- without its list work.
                case probe name json of
                    Nothing ->
                        if isObject json then
                            Spelled (Ok Nothing)

                        else
                            NotAnObject

                    Just found ->
                        if isArray json then
                            NotAnObject

                        else
                            Spelled (Ok (Just found))

        _ ->
            spelledAsAny names json


spelledAsAny : List String -> Value -> Spelled
spelledAsAny names json =
    if List.any isInherited names then
        case Json.Decode.decodeValue (Json.Decode.dict Json.Decode.value) json of
            Ok keys ->
                Spelled (oneSpelling names (List.filterMap (\name -> Dict.get name keys |> Maybe.map (Tuple.pair name)) names))

            Err _ ->
                NotAnObject

    else
        case List.filterMap (\name -> probe name json) names of
            [] ->
                if isObject json then
                    Spelled (Ok Nothing)

                else
                    NotAnObject

            found ->
                if isArray json then
                    NotAnObject

                else
                    Spelled (oneSpelling names found)


oneSpelling : List String -> List ( String, Value ) -> Result String (Maybe ( String, Value ))
oneSpelling names found =
    case found of
        [] ->
            Ok Nothing

        [ one ] ->
            Ok (Just one)

        _ ->
            Err ("Expecting " ++ String.join " or " (List.map quote names) ++ ", but got both")


{-| The value under `name`, when JavaScript's `in` finds it in `json`.
-}
probe : String -> Value -> Maybe ( String, Value )
probe name json =
    case Json.Decode.decodeValue (Json.Decode.field name Json.Decode.value) json of
        Ok raw ->
            Just ( name, raw )

        Err _ ->
            Nothing


{-| Whether `name` is a property every object inherits from `Object.prototype`.
-}
isInherited : String -> Bool
isInherited name =
    case name of
        "__proto__" ->
            True

        "__defineGetter__" ->
            True

        "__defineSetter__" ->
            True

        "__lookupGetter__" ->
            True

        "__lookupSetter__" ->
            True

        "constructor" ->
            True

        "hasOwnProperty" ->
            True

        "isPrototypeOf" ->
            True

        "propertyIsEnumerable" ->
            True

        "toLocaleString" ->
            True

        "toString" ->
            True

        "valueOf" ->
            True

        _ ->
            False


{-| Whether a JSON value is an object, in constant time: JavaScript's `in`
finds `hasOwnProperty` in every object and array, which inherit it, and in no
other JSON value, and arrays are told apart. Listing the object's keys would
take time in their number.
-}
isObject : Value -> Bool
isObject json =
    case Json.Decode.decodeValue (Json.Decode.field "hasOwnProperty" (Json.Decode.succeed ())) json of
        Ok () ->
            not (isArray json)

        Err _ ->
            False


{-| Whether a JSON value is an array, in constant time: decoding its elements
stops at the first, which `fail` rejects, and an empty array decodes.
-}
isArray : Value -> Bool
isArray json =
    case Json.Decode.decodeValue (Json.Decode.list (Json.Decode.fail "")) json of
        Ok _ ->
            True

        Err (Json.Decode.Index _ _) ->
            True

        Err _ ->
            False


{-| The failure of a message decoder given JSON that is not an object, as
elm/json words it.
-}
notAnObject : Decoder a
notAnObject =
    Json.Decode.fail "Expecting an OBJECT"


quote : String -> String
quote text =
    "\"" ++ text ++ "\""


isNull : Value -> Bool
isNull raw =
    case Json.Decode.decodeValue (Json.Decode.null ()) raw of
        Ok () ->
            True

        Err _ ->
            False


{-| A message's JSON object: each field that has a value, under its JSON name.
A field given `Nothing` is left out.

    objectOfFields
        [ ( "title", Just (Json.Encode.string "Hi") )
        , ( "author", Nothing )
        ]
    -- {"title":"Hi"}

-}
objectOfFields : List ( String, Maybe Value ) -> Value
objectOfFields fields =
    fields
        |> List.filterMap (\( key, value ) -> Maybe.map (Tuple.pair key) value)
        |> objectOf


{-| A JSON object from its pairs, keys kept in order. `Json.Encode.object`
assigns each pair to a JavaScript object, and assigning `__proto__` sets the
object's prototype rather than a property, so that key would be lost from the
output while `JSON.parse` reads it as a property. An object with it is built
as text and parsed, which keeps it.
-}
objectOf : List ( String, Value ) -> Value
objectOf pairs =
    if List.any (\( key, _ ) -> key == "__proto__") pairs then
        pairs
            |> List.map
                (\( key, value ) ->
                    Json.Encode.encode 0 (Json.Encode.string key)
                        ++ ":"
                        ++ Json.Encode.encode 0 value
                )
            |> String.join ","
            |> (\body -> "{" ++ body ++ "}")
            |> Json.Decode.decodeString Json.Decode.value
            |> Result.withDefault (Json.Encode.object pairs)

    else
        Json.Encode.object pairs


{-| A field without presence: `Nothing` when it holds its proto3 default, the
first argument, else its JSON. For a string, a number held as an `Int`, a
64-bit integer held as its decimal string, a `Bool`, bytes held as base64 or an
enum; a `Float` uses [`implicitFloatField`](#implicitFloatField), and bytes held as `Bytes`
[`implicitBytesField`](#implicitBytesField).

    implicitField "" Json.Encode.string "" -- Nothing

    implicitField 0 Json.Encode.int 3 -- Just 3

-}
implicitField : a -> (a -> Value) -> a -> Maybe Value
implicitField zero encode value =
    if value == zero then
        Nothing

    else
        Just (encode value)


{-| A `bytes` field held as `Bytes`, without presence: `Nothing` when it holds
no bytes, else its JSON as [`encodeBytesAsBytes`](#encodeBytesAsBytes) writes
it. Not [`implicitField`](#implicitField), which compares with `==`, and `==` finds any
two `Bytes` equal.
-}
implicitBytesField : Bytes -> Maybe Value
implicitBytesField value =
    if Bytes.width value == 0 then
        Nothing

    else
        Just (encodeBytesAsBytes value)


{-| A `double` or `float` field without presence: `Nothing` at `0`, else its
JSON as [`encodeFloat`](#encodeFloat) writes it. `-0`, NaN and the infinities
are not the default and are written; `-0` as `0`, since JavaScript's JSON
writer has no negative zero, and a server reads `+0` either way.
-}
implicitFloatField : Float -> Maybe Value
implicitFloatField number =
    if number == 0 && 1 / number > 0 then
        Nothing

    else
        Just (encodeFloat number)


{-| A repeated field: `Nothing` when empty, else a JSON array of its elements.
-}
repeatedField : (a -> Value) -> List a -> Maybe Value
repeatedField encode values =
    if List.isEmpty values then
        Nothing

    else
        Just (Json.Encode.list encode values)


{-| A map field: `Nothing` when empty, else a JSON object, keyed as
`Json.Encode.dict` keys it. A key of `__proto__` is kept as an ordinary key.
-}
dictField : (k -> String) -> (v -> Value) -> Dict.Dict k v -> Maybe Value
dictField key encode entries =
    if Dict.isEmpty entries then
        Nothing

    else
        entries
            |> Dict.toList
            |> List.map (\( k, v ) -> ( key k, encode v ))
            |> objectOf
            |> Just


{-| A map field with `bool` keys: `Nothing` when empty, else the object
[`encodeBoolMap`](#encodeBoolMap) writes.
-}
boolMapField : (a -> Value) -> List ( Bool, a ) -> Maybe Value
boolMapField encode pairs =
    if List.isEmpty pairs then
        Nothing

    else
        Just (encodeBoolMap encode pairs)


{-| Decode a oneof in a decoding pipeline: unlike [`field`](#field), the
decoder reads the message object itself, since each member of a oneof is a
key of the message. The decoder is usually [`members`](#members).

    type NoteKind
        = NoteKindUnset
        | NoteKindText String

    decodeNote : Decoder Note
    decodeNote =
        Json.Decode.succeed Note
            |> field "title" "" Json.Decode.string
            |> oneof decodeNoteKind

-}
oneof : Decoder a -> Decoder (a -> b) -> Decoder b
oneof decoder =
    Json.Decode.map2 (|>) decoder


{-| Decode a oneof from the message object, given the oneof's proto name (for
error messages), its unset value and its members:

    decodeNoteKind : Decoder NoteKind
    decodeNoteKind =
        members "kind"
            NoteKindUnset
            [ member "text" (Json.Decode.map NoteKindText Json.Decode.string)
            , memberEither "pageCount" "page_count" (Json.Decode.map NoteKindPageCount int32)
            ]

A member is present when the object holds its key with a value other than
`null`, which proto3 JSON reads as absent; a [`valueMember`](#valueMember) is
present when it holds `null` too. Then:

  - no member present decodes as the unset value;
  - one member present decodes as that member, and when its value does not
    satisfy the member's decoder the oneof fails, and with it the message;
  - more than one member present fails, naming the keys found:
    `Expecting at most one member of oneof "kind", but got "text" and "pageCount"`.

A member written under both its JSON name and its proto name fails, as a field
does in [`fieldEither`](#fieldEither).

-}
members : String -> a -> List (Member a) -> Decoder a
members oneofName unset candidates =
    Json.Decode.value
        |> Json.Decode.andThen
            (\object_ ->
                case presentMembers object_ candidates of
                    Nothing ->
                        notAnObject

                    Just (Err problem) ->
                        Json.Decode.fail problem

                    Just (Ok []) ->
                        Json.Decode.succeed unset

                    Just (Ok [ ( name, decoder ) ]) ->
                        Json.Decode.field name decoder

                    Just (Ok several) ->
                        Json.Decode.fail
                            ("Expecting at most one member of oneof "
                                ++ quote oneofName
                                ++ ", but got "
                                ++ listing (List.map (\( name, _ ) -> quote name) several)
                            )
            )


{-| The members the object holds, each with the key it is written under;
`Nothing` when the JSON is not an object.
-}
presentMembers : Value -> List (Member a) -> Maybe (Result String (List ( String, Decoder a )))
presentMembers json candidates =
    if isObject json then
        Just (presentIn json candidates [])

    else
        Nothing


presentIn : Value -> List (Member a) -> List ( String, Decoder a ) -> Result String (List ( String, Decoder a ))
presentIn json candidates found =
    case candidates of
        [] ->
            Ok (List.reverse found)

        (Member candidate) :: rest ->
            case spelledAs candidate.names json of
                Spelled (Ok (Just ( name, raw ))) ->
                    if isNull raw && not candidate.nullIsSet then
                        presentIn json rest found

                    else
                        presentIn json rest (( name, candidate.decoder ) :: found)

                Spelled (Ok Nothing) ->
                    presentIn json rest found

                Spelled (Err problem) ->
                    Err problem

                NotAnObject ->
                    Ok (List.reverse found)


{-| `"a" and "b"`, `"a", "b" and "c"`.
-}
listing : List String -> String
listing items =
    case List.reverse items of
        last :: ((_ :: _) as before) ->
            String.join ", " (List.reverse before) ++ " and " ++ last

        _ ->
            String.concat items


{-| One member of a oneof, for [`members`](#members): the keys it may be
written under and the decoder of its value.
-}
type Member a
    = Member
        { names : List String
        , nullIsSet : Bool
        , decoder : Decoder a
        }


{-| A member of a oneof: its key and the decoder of its value. A `null` value
reads as absent.

    member "text" (Json.Decode.map NoteKindText Json.Decode.string)

-}
member : String -> Decoder a -> Member a
member name =
    memberEither name name


{-| [`member`](#member) for a member whose JSON name differs from its proto
name: the JSON name first, then the proto name, as in
[`fieldEither`](#fieldEither).
-}
memberEither : String -> String -> Decoder a -> Member a
memberEither jsonName protoName decoder =
    Member { names = spellings jsonName protoName, nullIsSet = False, decoder = decoder }


{-| A member of type `google.protobuf.Empty`, whose constructor carries
nothing: present when its key holds an object (usually `{}`). `null` reads as
absent, and any other value fails.

    type ActionKind
        = ActionKindUnset
        | ActionKindClear

    decodeActionKind : Decoder ActionKind
    decodeActionKind =
        members "kind" ActionKindUnset [ emptyMember "clear" ActionKindClear ]

-}
emptyMember : String -> a -> Member a
emptyMember name =
    emptyMemberEither name name


{-| [`emptyMember`](#emptyMember) for a member whose JSON name differs from its
proto name: the JSON name first, then the proto name.
-}
emptyMemberEither : String -> String -> a -> Member a
emptyMemberEither jsonName protoName value =
    memberEither jsonName protoName (Json.Decode.map (\_ -> value) empty)


{-| A member of type `google.protobuf.Value`, given its constructor. Its value
is any JSON, `null` included: unlike every other member, one present as `null`
is set and holds the JSON `null`, as protobuf's own parsers read it.

    valueMember "payload" NoteKindPayload

-}
valueMember : String -> (Value -> a) -> Member a
valueMember name =
    valueMemberEither name name


{-| [`valueMember`](#valueMember) for a member whose JSON name differs from its
proto name: the JSON name first, then the proto name.
-}
valueMemberEither : String -> String -> (Value -> a) -> Member a
valueMemberEither jsonName protoName constructor =
    Member
        { names = spellings jsonName protoName
        , nullIsSet = True
        , decoder = Json.Decode.map constructor Json.Decode.value
        }


{-| Decode an enum, given its proto name, its zero value and a row per value
name: the name, its number and its constructor. proto3 JSON writes an enum as
its value's name, and a parser must also accept the number.

A number the rows do not hold, such as one added to the server's proto after
this client was generated, decodes as the zero value. A name the rows do not
hold fails, as protobuf's own parsers do:
`Expecting a value of enum "Status", but got "STATUS_PAUSED"`; for a decoder
that reads it as the zero value instead, see [`enumOrZero`](#enumOrZero).

    type Status
        = StatusUnspecified
        | StatusActive

    decodeStatus : Decoder Status
    decodeStatus =
        enum "Status"
            StatusUnspecified
            [ ( "STATUS_UNSPECIFIED", 0, StatusUnspecified )
            , ( "STATUS_ACTIVE", 1, StatusActive )
            , ( "STATUS_LIVE", 1, StatusActive )
            ]

An alias (`allow_alias`) is a second row for the same constructor, so both
names decode to it. When two rows share a name or a number, the first wins.

-}
enum : String -> a -> List ( String, Int, a ) -> Decoder a
enum enumName zero values =
    enumWith
        (\text -> Json.Decode.fail ("Expecting a value of enum " ++ quote enumName ++ ", but got " ++ quote text))
        zero
        values


{-| Decode an enum as [`enum`](#enum) does, with the same arguments, except
that a name the rows do not hold decodes as the zero value too, as an unknown
number does. Nothing a JSON string or integer holds fails; anything else (a
fraction, a boolean, an object) still does, with elm/json's own error. No
failure names the enum, so its name goes unused; it is taken so the two read
alike. Code generated with `enum_unknown=zero` calls this one.

It suits a client that outlives the server's deploys: a value the server adds
reaches it as a name, and with `enum` that fails the whole message it is in.
The zero value is the one proto3 reserves for "unspecified", which is what
makes reading it here sound, but the distinction is dropped: the client cannot
tell the value it does not know from the zero value, and re-encoding sends the
zero value's name.

-}
enumOrZero : String -> a -> List ( String, Int, a ) -> Decoder a
enumOrZero _ zero values =
    enumWith (\_ -> Json.Decode.succeed zero) zero values


{-| `enum` and `enumOrZero`, which differ in what an unknown name reads as.
-}
enumWith : (String -> Decoder a) -> a -> List ( String, Int, a ) -> Decoder a
enumWith unknownName zero values =
    let
        lookup matches =
            values
                |> List.filter matches
                |> List.head
                |> Maybe.map (\( _, _, value ) -> value)
    in
    Json.Decode.oneOf
        [ Json.Decode.map Ok Json.Decode.string
        , Json.Decode.map Err Json.Decode.int
        ]
        |> Json.Decode.andThen
            (\form ->
                case form of
                    Ok text ->
                        case lookup (\( name, _, _ ) -> name == text) of
                            Just value ->
                                Json.Decode.succeed value

                            Nothing ->
                                unknownName text

                    Err int ->
                        lookup (\( _, number, _ ) -> number == int)
                            |> Maybe.withDefault zero
                            |> Json.Decode.succeed
            )


{-| Decode a map with signed 32-bit integer keys (`int32`, `sint32`,
`sfixed32`). JSON object keys are strings, so proto3 JSON writes each key as
its decimal string. A key is an integer written as an `int64` string may be,
in decimal or exponent notation, within -2147483648 to 2147483647: `"7"`,
`"-7"`, `"1e2"`, and `"07"`, whose leading zero protobuf's own parsers accept
too. Any other key fails, such as `"abc"`, `"1.5"`, `"+5"` or `"2147483648"`,
and so do two keys that name one integer, such as `"7"` and `"07"`.

    Json.Decode.decodeString (int32Dict Json.Decode.string) """{"1":"a","-2":"b"}"""
    -- Ok (Dict.fromList [ ( -2, "b" ), ( 1, "a" ) ])

Encode one with `Json.Encode.dict String.fromInt`.

-}
int32Dict : Decoder a -> Decoder (Dict.Dict Int a)
int32Dict =
    keyedDict (boundedKey "an int32 map key (-2147483648 to 2147483647)" -2147483648 2147483647)


{-| Decode a map with unsigned 32-bit integer keys (`uint32`, `fixed32`): the
keys [`int32Dict`](#int32Dict) accepts, within 0 to 4294967295.
-}
uint32Dict : Decoder a -> Decoder (Dict.Dict Int a)
uint32Dict =
    keyedDict (boundedKey "a uint32 map key (0 to 4294967295)" 0 4294967295)


{-| Decode a map with signed 64-bit integer keys (`int64`, `sint64`,
`sfixed64`), keyed by decimal strings as [`int64`](#int64) holds its values,
whatever the `int64` option. A key is read as `int64` reads a string, within
-9223372036854775808 to 9223372036854775807, and held in its canonical form:
`"007"` is the key `"7"`, `"1e3"` the key `"1000"`. Any other key fails, such
as `"abc"`, `"1.5"` or `"9223372036854775808"`, and so do two keys that name
one integer, such as `"7"` and `"007"`.

    Json.Decode.decodeString (int64Dict Json.Decode.string) """{"007":"a","-2":"b"}"""
    -- Ok (Dict.fromList [ ( "-2", "b" ), ( "7", "a" ) ])

Encode one with `Json.Encode.dict identity`.

-}
int64Dict : Decoder a -> Decoder (Dict.Dict String a)
int64Dict =
    keyedDict (wideKey "an int64 map key" Signed)


{-| Decode a map with unsigned 64-bit integer keys (`uint64`, `fixed64`): the
keys [`int64Dict`](#int64Dict) accepts, within 0 to 18446744073709551615
(2^64 - 1).
-}
uint64Dict : Decoder a -> Decoder (Dict.Dict String a)
uint64Dict =
    keyedDict (wideKey "a uint64 map key" Unsigned)


{-| A map whose keys `readKey` reads from their text, failing on a key it
rejects and on two keys it reads as one.
-}
keyedDict : (String -> Result String comparable) -> Decoder a -> Decoder (Dict.Dict comparable a)
keyedDict readKey decoder =
    Json.Decode.keyValuePairs decoder
        |> Json.Decode.andThen (\pairs -> fromResult (insertKeys readKey Dict.empty Dict.empty pairs))


insertKeys : (String -> Result String comparable) -> Dict.Dict comparable String -> Dict.Dict comparable a -> List ( String, a ) -> Result String (Dict.Dict comparable a)
insertKeys readKey seen entries pairs =
    case pairs of
        [] ->
            Ok entries

        ( text, value ) :: rest ->
            case readKey text of
                Err problem ->
                    Err problem

                Ok key ->
                    case Dict.get key seen of
                        Just earlier ->
                            Err ("Expecting distinct map keys, but " ++ quote earlier ++ " and " ++ quote text ++ " are the same key")

                        Nothing ->
                            insertKeys readKey (Dict.insert key text seen) (Dict.insert key value entries) rest


{-| A 32-bit integer map key within `low` to `high`, read as an `int64` string
is.
-}
boundedKey : String -> Int -> Int -> String -> Result String Int
boundedKey what low high text =
    narrowInteger low high text
        |> Result.mapError (\_ -> "Expecting " ++ what ++ ", but got " ++ quote text)


{-| A 64-bit integer map key in its canonical decimal form, within the range
of `width`.
-}
wideKey : String -> Width -> String -> Result String String
wideKey what width text =
    wideInteger width text
        |> Result.mapError (\_ -> "Expecting " ++ what ++ " " ++ widthRange width ++ ", but got " ++ quote text)


{-| Decode a map with `bool` keys as an association list, since Elm's `Bool`
is not `comparable` and so cannot key a `Dict`. proto3 JSON writes each key as
`"true"` or `"false"`; any other key fails. The pairs come in the object's key
order, and a map has at most two.

    Json.Decode.decodeString (boolMap Json.Decode.string) """{"true":"on","false":"off"}"""
    -- Ok [ ( True, "on" ), ( False, "off" ) ]

-}
boolMap : Decoder a -> Decoder (List ( Bool, a ))
boolMap decoder =
    Json.Decode.keyValuePairs decoder
        |> Json.Decode.andThen
            (\pairs ->
                List.foldr
                    (\( key, value ) result ->
                        Result.map2 (\bool rest -> ( bool, value ) :: rest)
                            (boolKey key)
                            result
                    )
                    (Ok [])
                    pairs
                    |> fromResult
            )


boolKey : String -> Result String Bool
boolKey key =
    case key of
        "true" ->
            Ok True

        "false" ->
            Ok False

        _ ->
            Err ("Expecting a bool map key (\"true\" or \"false\"), but got \"" ++ key ++ "\"")


fromResult : Result String a -> Decoder a
fromResult result =
    case result of
        Ok value ->
            Json.Decode.succeed value

        Err problem ->
            Json.Decode.fail problem


{-| Encode a map with `bool` keys, held as an association list, as a JSON
object keyed `"true"` and `"false"`. When a key appears twice, the later pair
is the one a parser keeps.

    encodeBoolMap Json.Encode.string [ ( True, "on" ) ] -- {"true":"on"}

-}
encodeBoolMap : (a -> Value) -> List ( Bool, a ) -> Value
encodeBoolMap encode pairs =
    pairs
        |> List.map
            (\( key, value ) ->
                ( if key then
                    "true"

                  else
                    "false"
                , encode value
                )
            )
        |> Json.Encode.object


{-| Decode a signed 32-bit integer (`int32`, `sint32`, `sfixed32`).

proto3 JSON writes these as numbers, and a parser must also accept a string
and exponent notation: `42`, `"42"`, `1e2` and `"1e2"` all decode, as does
`4.0`. A string takes the forms [`int64`](#int64) reads one in, so `"007"` is
7 and `"+5"` fails. A value with a fractional part fails, and so does one
outside the type's range, -2147483648 to 2147483647.

-}
int32 : Decoder Int
int32 =
    boundedInt "an int32 (-2147483648 to 2147483647)" -2147483648 2147483647


{-| Decode an unsigned 32-bit integer (`uint32`, `fixed32`): the forms
[`int32`](#int32) accepts, within 0 to 4294967295.
-}
uint32 : Decoder Int
uint32 =
    boundedInt "a uint32 (0 to 4294967295)" 0 4294967295


{-| A JSON number, or a JSON string that should hold one.
-}
type Numeric
    = NumberForm Float
    | StringForm String


numeric : Decoder Numeric
numeric =
    Json.Decode.oneOf
        [ Json.Decode.map NumberForm Json.Decode.float
        , Json.Decode.map StringForm Json.Decode.string
        ]


showNumeric : Numeric -> String
showNumeric form =
    case form of
        NumberForm number ->
            String.fromFloat number

        StringForm text ->
            "\"" ++ text ++ "\""


{-| An integer in any form proto3 JSON allows for one, within `low` to
`high`: a number compared as a `Float`, which holds the bounds exactly, and a
string read as [`int64`](#int64) reads one.
-}
boundedInt : String -> Int -> Int -> Decoder Int
boundedInt what low high =
    let
        outOfRange form =
            Json.Decode.fail ("Expecting " ++ what ++ ", but got " ++ showNumeric form)
    in
    numeric
        |> Json.Decode.andThen
            (\form ->
                case form of
                    NumberForm _ ->
                        case integral form of
                            Err problem ->
                                Json.Decode.fail problem

                            Ok number ->
                                if number < toFloat low || number > toFloat high then
                                    outOfRange form

                                else
                                    Json.Decode.succeed (round number)

                    StringForm text ->
                        case narrowInteger low high text of
                            Ok int ->
                                Json.Decode.succeed int

                            Err OutOfRange ->
                                outOfRange form

                            Err _ ->
                                Json.Decode.fail ("Expecting an integer, but got " ++ showNumeric form)
            )


{-| A 32-bit integer written as text, as [`int64`](#int64) reads a string,
within `low` to `high`.
-}
narrowInteger : Int -> Int -> String -> Result IntegerProblem Int
narrowInteger low high text =
    canonicalInteger text
        |> Result.andThen
            (\decimal ->
                case String.toInt decimal of
                    Just int ->
                        if int >= low && int <= high then
                            Ok int

                        else
                            Err OutOfRange

                    Nothing ->
                        Err NotDecimal
            )


{-| The integral value of a number, or of a string holding one in decimal or
exponent notation.
-}
integral : Numeric -> Result String Float
integral form =
    let
        number =
            case form of
                NumberForm value ->
                    Just value

                StringForm text ->
                    String.toFloat text

        notInteger =
            Err ("Expecting an integer, but got " ++ showNumeric form)
    in
    case number of
        Just value ->
            if isNaN value || isInfinite value || toFloat (round value) /= value then
                notInteger

            else
                Ok value

        Nothing ->
            notInteger


{-| Decode a 64-bit integer (`int64`, `uint64`, `sint64`, `fixed64`,
`sfixed64`) as its decimal string, since Elm's `Int` is exact only up to
2^53.

proto3 JSON writes these as strings, and a parser must accept either a string
or a number, in exponent notation too. The result is always the canonical
decimal string, with no leading zeros:

    "42", 42           --> "42"
    "1e3", "1.5e3"     --> "1000", "1500"
    1E2, "-2e0"        --> "100", "-2"
    "007", "-0"        --> "7", "0"

A value that is not an integer fails (`"4.2"`, `"1.5e0"`), and so does one
outside the type's range, -9223372036854775808 to 9223372036854775807
(`"9223372036854775808"`). Exponent notation is read as text, by moving the
decimal point, so a string keeps every digit. A number past 2^53 was already
rounded when the JSON was parsed, before this decoder saw it, and is read as
JavaScript writes it (`9223372036854775807` as `"9223372036854776000"`, which
is out of range).

-}
int64 : Decoder String
int64 =
    wide Signed


{-| A 64-bit integer as its canonical decimal string, within the range of
`width`.
-}
wide : Width -> Decoder String
wide width =
    Json.Decode.oneOf
        [ Json.Decode.map (\text -> ( text, True )) Json.Decode.string
        , Json.Decode.map (\int -> ( String.fromInt int, False )) Json.Decode.int
        ]
        |> Json.Decode.andThen
            (\( text, quoted ) ->
                let
                    shown () =
                        if quoted then
                            quote text

                        else
                            text
                in
                case wideInteger width text of
                    Ok decimal ->
                        Json.Decode.succeed decimal

                    Err NotDecimal ->
                        Json.Decode.fail ("Expecting a decimal integer, but got " ++ shown ())

                    Err NotInteger ->
                        Json.Decode.fail ("Expecting an integer, but got " ++ shown ())

                    Err OutOfRange ->
                        Json.Decode.fail ("Expecting " ++ widthName width ++ " " ++ widthRange width ++ ", but got " ++ shown ())
            )


{-| The 64-bit integer types' two ranges.
-}
type Width
    = Signed
    | Unsigned


widthName : Width -> String
widthName width =
    case width of
        Signed ->
            "an int64"

        Unsigned ->
            "a uint64"


widthRange : Width -> String
widthRange width =
    case width of
        Signed ->
            "(-9223372036854775808 to 9223372036854775807)"

        Unsigned ->
            "(0 to 18446744073709551615)"


{-| Why text is not an integer of a type.
-}
type IntegerProblem
    = NotDecimal
    | NotInteger
    | OutOfRange


{-| The canonical decimal form of a 64-bit integer written as text, within
the range of `width`. The digits are compared with the bound's as text, by
length and then digit by digit, since an `Int` is exact only to 2^53.
-}
wideInteger : Width -> String -> Result IntegerProblem String
wideInteger width text =
    canonicalInteger text
        |> Result.andThen
            (\decimal ->
                let
                    inRange =
                        case ( width, String.startsWith "-" decimal ) of
                            ( Signed, True ) ->
                                atMost "9223372036854775808" (String.dropLeft 1 decimal)

                            ( Signed, False ) ->
                                atMost "9223372036854775807" decimal

                            ( Unsigned, True ) ->
                                False

                            ( Unsigned, False ) ->
                                atMost "18446744073709551615" decimal
                in
                if inRange then
                    Ok decimal

                else
                    Err OutOfRange
            )


{-| Whether the digits of a canonical natural number (no leading zeros) are at
most `bound`'s.
-}
atMost : String -> String -> Bool
atMost bound digits =
    String.length digits
        < String.length bound
        || (String.length digits == String.length bound && digits <= bound)


{-| The canonical decimal form of an integer written as text in decimal or
exponent notation (`"-1.5e3"` is `"-1500"`), found by moving the decimal point
rather than through a `Float`, which would round past 2^53. One of more than
20 digits, past every 64-bit integer, is `OutOfRange` without being written
out, so an exponent cannot ask for a string of any length.
-}
canonicalInteger : String -> Result IntegerProblem String
canonicalInteger text =
    let
        ( sign, unsigned ) =
            if String.startsWith "-" text then
                ( "-", String.dropLeft 1 text )

            else
                ( "", text )
    in
    if isCanonicalNatural unsigned && String.length unsigned <= 20 && not (sign == "-" && unsigned == "0") then
        -- Already canonical, as almost every 64-bit integer a server writes is:
        -- the digits are the answer, without taking them apart.
        Ok text

    else
        canonicalFrom sign unsigned


{-| Whether text is a natural number's canonical decimal digits: `0`, or
digits not beginning with `0`.
-}
isCanonicalNatural : String -> Bool
isCanonicalNatural text =
    case String.uncons text of
        Just ( '0', rest ) ->
            String.isEmpty rest

        Just ( first, _ ) ->
            Char.isDigit first && String.all Char.isDigit text

        Nothing ->
            False


canonicalFrom : String -> String -> Result IntegerProblem String
canonicalFrom sign unsigned =
    case scientific unsigned of
        Nothing ->
            Err NotDecimal

        Just { digits, point } ->
            let
                leading =
                    leadingCount '0' digits

                significant =
                    String.dropLeft leading digits

                -- The point counted from the first significant digit.
                shifted =
                    point - leading

                kept =
                    String.dropRight (trailingCount '0' significant) significant
            in
            if String.isEmpty kept then
                Ok "0"

            else if String.length kept > shifted then
                Err NotInteger

            else if shifted > 20 then
                Err OutOfRange

            else
                Ok (sign ++ kept ++ String.repeat (shifted - String.length kept) "0")


{-| An unsigned number in decimal or exponent notation (`1`, `1.5`, `15e-1`,
`1.5E+0`) as its digits and the position of the decimal point among them,
which may lie outside them.
-}
scientific : String -> Maybe { digits : String, point : Int }
scientific text =
    let
        allDigits part =
            not (String.isEmpty part) && String.all Char.isDigit part

        exponentOf part =
            if allDigits (String.dropLeft 1 part) && (String.startsWith "+" part || String.startsWith "-" part) then
                String.toInt part

            else if allDigits part then
                String.toInt part

            else
                Nothing

        ( mantissa, exponent ) =
            case String.split "e" (String.toLower text) of
                [ whole ] ->
                    ( whole, Just 0 )

                [ whole, power ] ->
                    ( whole, exponentOf power )

                _ ->
                    ( "", Nothing )

        parts =
            case String.split "." mantissa of
                [ whole ] ->
                    Just ( whole, "" )

                [ whole, fraction ] ->
                    if allDigits fraction then
                        Just ( whole, fraction )

                    else
                        Nothing

                _ ->
                    Nothing
    in
    case ( parts, exponent ) of
        ( Just ( whole, fraction ), Just power ) ->
            if allDigits whole then
                Just { digits = whole ++ fraction, point = String.length whole + power }

            else
                Nothing

        _ ->
            Nothing


{-| How many times `char` repeats at the start of `text`, in one pass.
-}
leadingCount : Char -> String -> Int
leadingCount char text =
    String.foldl
        (\c ( count, counting ) ->
            if counting && c == char then
                ( count + 1, True )

            else
                ( count, False )
        )
        ( 0, True )
        text
        |> Tuple.first


{-| How many times `char` repeats at the end of `text`, in one pass.
-}
trailingCount : Char -> String -> Int
trailingCount char text =
    String.foldr
        (\c ( count, counting ) ->
            if counting && c == char then
                ( count + 1, True )

            else
                ( count, False )
        )
        ( 0, True )
        text
        |> Tuple.first


{-| Encode a 64-bit integer, held as its decimal string, as proto3 JSON does:
as a JSON string.
-}
encodeInt64 : String -> Value
encodeInt64 =
    Json.Encode.string


{-| Decode a 64-bit integer as an `Int`, for code generated with the
`int64=int` option or for a field marked `[jstype = JS_NUMBER]`.

It accepts a JSON number or a string, in decimal or exponent notation, as
proto3 JSON requires (`42`, `"42"`, `"4.2e1"`), and fails on a value that is not an integer or lies outside ±9007199254740991,
where Elm's `Int` stops being exact; see
[`Proto.Int64.toInt`](Proto-Int64#toInt). A number past that range was
already rounded when the JSON was parsed, and fails too.

-}
int64AsInt : Decoder Int
int64AsInt =
    numeric |> Json.Decode.andThen int64Form


{-| Decode an unsigned 64-bit integer (`uint64`, `fixed64`) as its decimal
string: the forms [`int64`](#int64) accepts, within 0 to 18446744073709551615
(2^64 - 1).
-}
uint64 : Decoder String
uint64 =
    wide Unsigned


{-| Decode an unsigned 64-bit integer as an `Int`, under the `int64=int`
option: the forms [`int64AsInt`](#int64AsInt) accepts, from 0 up to
the largest `Int` that is exact, 9007199254740991.
-}
uint64AsInt : Decoder Int
uint64AsInt =
    int64AsInt
        |> Json.Decode.andThen
            (\number ->
                if number < 0 then
                    Json.Decode.fail ("Expecting a uint64 (0 or more) but got " ++ String.fromInt number)

                else
                    Json.Decode.succeed number
            )


int64Form : Numeric -> Decoder Int
int64Form form =
    let
        outOfRange () =
            Json.Decode.fail
                ("Expecting an integer from -9007199254740991 to 9007199254740991, "
                    ++ "the 64-bit integers an Elm Int holds exactly, but got "
                    ++ showNumeric form
                )
    in
    case form of
        NumberForm number ->
            case integral form of
                Err problem ->
                    Json.Decode.fail problem

                Ok _ ->
                    if abs number > 9007199254740991 then
                        outOfRange ()

                    else
                        Json.Decode.succeed (round number)

        StringForm text ->
            case canonicalInteger text of
                Err NotDecimal ->
                    Json.Decode.fail ("Expecting a decimal integer, but got " ++ quote text)

                Err NotInteger ->
                    Json.Decode.fail ("Expecting an integer, but got " ++ quote text)

                Err OutOfRange ->
                    outOfRange ()

                Ok decimal ->
                    case Proto.Int64.toInt decimal of
                        Just int ->
                            Json.Decode.succeed int

                        Nothing ->
                            outOfRange ()


{-| Encode a 64-bit integer held as an `Int` as proto3 JSON writes one: its
decimal string, as a JSON string.

    encodeInt64AsInt 42 -- "42"

-}
encodeInt64AsInt : Int -> Value
encodeInt64AsInt int =
    Json.Encode.string (Proto.Int64.fromInt int)


{-| Decode a `double` or `float`. proto3 JSON writes a finite value as a
number and the others as the strings `"NaN"`, `"Infinity"` and `"-Infinity"`;
a parser must also accept a finite value written as a string, such as `"1.5"`.
-}
float : Decoder Float
float =
    Json.Decode.oneOf
        [ Json.Decode.float
        , Json.Decode.string |> Json.Decode.andThen floatString
        ]


floatString : String -> Decoder Float
floatString text =
    case text of
        "NaN" ->
            Json.Decode.succeed (0 / 0)

        "Infinity" ->
            Json.Decode.succeed (1 / 0)

        "-Infinity" ->
            Json.Decode.succeed -(1 / 0)

        _ ->
            case String.toFloat text of
                Just number ->
                    Json.Decode.succeed number

                Nothing ->
                    Json.Decode.fail ("Expecting a number, but got \"" ++ text ++ "\"")


{-| Encode a `double` or `float`: a finite value as a JSON number, NaN and the
infinities as the strings proto3 JSON uses for them.
-}
encodeFloat : Float -> Value
encodeFloat number =
    if isNaN number then
        Json.Encode.string "NaN"

    else if isInfinite number then
        if number > 0 then
            Json.Encode.string "Infinity"

        else
            Json.Encode.string "-Infinity"

    else
        Json.Encode.float number


{-| Decode `bytes`, which proto3 JSON writes as a base64 string, as that
string, kept exactly as it arrived (not normalised to one alphabet or
padding).

The string must be base64, as proto3 JSON parsers accept it: the standard
alphabet (`A`–`Z`, `a`–`z`, `0`–`9`, `+`, `/`) or the URL-safe one (`-` and
`_` in place of `+` and `/`), not both in one string, with or without `=`
padding. Anything else fails: another character, a length no base64 text has,
or padding that does not fit the length.

    Json.Decode.decodeString bytes "\"aGk=\"" -- Ok "aGk="

    Json.Decode.decodeString bytes "\"aGk\"" -- Ok "aGk"

    Json.Decode.decodeString bytes "\"a\"" -- Err ...

-}
bytes : Decoder String
bytes =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                if isBase64 text then
                    Json.Decode.succeed text

                else
                    Json.Decode.fail ("Expecting base64 (standard or URL-safe, padding optional), but got \"" ++ text ++ "\"")
            )


isBase64 : String -> Bool
isBase64 text =
    let
        body =
            dropPadding text

        length =
            String.length body

        padding =
            String.length text - length

        partial =
            modBy 4 length

        standard =
            String.any (\char -> char == '+' || char == '/') body

        urlSafe =
            String.any (\char -> char == '-' || char == '_') body
    in
    String.all isBase64Char body
        && not (standard && urlSafe)
        && (partial /= 1)
        && (padding == 0 || (partial /= 0 && padding == 4 - partial))


isBase64Char : Char -> Bool
isBase64Char char =
    Char.isAlphaNum char || char == '+' || char == '/' || char == '-' || char == '_'


dropPadding : String -> String
dropPadding text =
    String.dropRight (trailingCount '=' text) text


{-| Encode `bytes`, held as a base64 string, as that string, unchecked.
-}
encodeBytes : String -> Value
encodeBytes =
    Json.Encode.string


{-| Decode `bytes`, which proto3 JSON writes as a base64 string, as the bytes
it holds. It accepts what [`bytes`](#bytes) accepts.

    Json.Decode.decodeString bytesAsBytes "\"aGk=\"" |> Result.map Bytes.width -- Ok 2

    Json.Decode.decodeString bytesAsBytes "\"a\"" -- Err ...

-}
bytesAsBytes : Decoder Bytes
bytesAsBytes =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                case Proto.Bytes.fromBase64 text of
                    Just value ->
                        Json.Decode.succeed value

                    Nothing ->
                        Json.Decode.fail ("Expecting base64 (standard or URL-safe, padding optional), but got \"" ++ text ++ "\"")
            )


{-| Encode `bytes` held as `Bytes` as base64 text: the standard alphabet, with
`=` padding, as proto3 JSON writes it.
-}
encodeBytesAsBytes : Bytes -> Value
encodeBytesAsBytes value =
    Json.Encode.string (Proto.Bytes.toBase64 value)


{-| Decode a `google.protobuf.Timestamp`, an RFC 3339 string; see
[`Proto.Timestamp.fromString`](Proto-Timestamp#fromString).
-}
timestamp : Decoder Time.Posix
timestamp =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                case Proto.Timestamp.fromString text of
                    Just posix ->
                        Json.Decode.succeed posix

                    Nothing ->
                        Json.Decode.fail ("Expecting an RFC 3339 timestamp, but got \"" ++ text ++ "\"")
            )


{-| Encode a `google.protobuf.Timestamp`; see
[`Proto.Timestamp.toString`](Proto-Timestamp#toString).
-}
encodeTimestamp : Time.Posix -> Value
encodeTimestamp posix =
    Json.Encode.string (Proto.Timestamp.toString posix)


{-| Decode a `google.protobuf.Duration`, such as `"1.5s"`; see
[`Proto.Duration.fromString`](Proto-Duration#fromString).
-}
duration : Decoder Duration
duration =
    Json.Decode.string
        |> Json.Decode.andThen
            (\text ->
                case Proto.Duration.fromString text of
                    Just value ->
                        Json.Decode.succeed value

                    Nothing ->
                        Json.Decode.fail ("Expecting a duration such as \"1.5s\", but got \"" ++ text ++ "\"")
            )


{-| Encode a `google.protobuf.Duration`; see
[`Proto.Duration.toString`](Proto-Duration#toString).
-}
encodeDuration : Duration -> Value
encodeDuration value =
    Json.Encode.string (Proto.Duration.toString value)


{-| Decode a `google.protobuf.FieldMask` into its paths. proto3 JSON writes a
mask as one string, the paths joined by commas, each field name in
lowerCamelCase; the paths come back with proto field names, as a server
expects them:

    Json.Decode.decodeString fieldMask "\"displayName,author.emailAddress\""
    -- Ok [ "display_name", "author.email_address" ]

The empty string is the empty mask.

-}
fieldMask : Decoder (List String)
fieldMask =
    Json.Decode.string
        |> Json.Decode.map
            (\text ->
                if String.isEmpty text then
                    []

                else
                    String.split "," text
                        |> List.map (mapSegments snakeCase)
            )


{-| Encode a `google.protobuf.FieldMask` from its paths, written with proto
field names (`"author.email_address"`): each field name in lowerCamelCase, the
paths joined by commas.
-}
encodeFieldMask : List String -> Value
encodeFieldMask paths =
    paths
        |> List.map (mapSegments camelCase)
        |> String.join ","
        |> Json.Encode.string


mapSegments : (String -> String) -> String -> String
mapSegments convert path =
    String.split "." path
        |> List.map convert
        |> String.join "."


camelCase : String -> String
camelCase name =
    case String.split "_" name of
        first :: rest ->
            first ++ String.concat (List.map capitalize rest)

        [] ->
            name


capitalize : String -> String
capitalize word =
    String.toUpper (String.left 1 word) ++ String.dropLeft 1 word


snakeCase : String -> String
snakeCase name =
    String.toList name
        |> List.concatMap
            (\char ->
                if Char.isUpper char then
                    [ '_', Char.toLower char ]

                else
                    [ char ]
            )
        |> String.fromList


{-| Decode a `google.protobuf.Empty`: any JSON object, usually `{}`. A field
of it reads as `()` when absent or `null` too, so its presence is not kept.
-}
empty : Decoder ()
empty =
    Json.Decode.value
        |> Json.Decode.andThen
            (\json ->
                if isObject json then
                    Json.Decode.succeed ()

                else
                    notAnObject
            )


{-| Encode a `google.protobuf.Empty` as `{}`.
-}
encodeEmpty : () -> Value
encodeEmpty () =
    Json.Encode.object []


{-| Decode a `google.protobuf.Struct`, a JSON object, into its members. Any
other JSON, such as an array, fails.

    Json.Decode.decodeString struct """{"a":1}"""
    -- Ok (Dict.fromList [ ( "a", Json.Encode.int 1 ) ])

-}
struct : Decoder (Dict.Dict String Value)
struct =
    Json.Decode.dict Json.Decode.value


{-| Encode a `google.protobuf.Struct` from its members, as a JSON object.
-}
encodeStruct : Dict.Dict String Value -> Value
encodeStruct fields =
    objectOf (Dict.toList fields)


{-| Decode a `google.protobuf.ListValue`, a JSON array, into its elements. Any
other JSON, such as an object, fails.
-}
listValue : Decoder (List Value)
listValue =
    Json.Decode.list Json.Decode.value


{-| Encode a `google.protobuf.ListValue` from its elements, as a JSON array.
-}
encodeListValue : List Value -> Value
encodeListValue =
    Json.Encode.list identity


{-| Decode a `google.protobuf.Any`: an object with `"@type"`, holding the
message's fields or, for a well-known type with a JSON form of its own,
`"value"`. An object without `"@type"` fails, but for `{}`, the empty `Any`.
Unpack it with [`Proto.Any.unpack`](Proto-Any#unpack).
-}
any : Decoder Any
any =
    Json.Decode.keyValuePairs Json.Decode.value
        |> Json.Decode.andThen anyFromPairs


anyFromPairs : List ( String, Value ) -> Decoder Any
anyFromPairs pairs =
    case ( pairValue "@type" pairs, pairs ) of
        ( Nothing, [] ) ->
            Json.Decode.succeed (InternalAny.Any "" (InBinary ""))

        ( Nothing, _ ) ->
            Json.Decode.fail "Expecting an Any: an object with \"@type\""

        ( Just found, _ ) ->
            case Json.Decode.decodeValue Json.Decode.string found of
                Err _ ->
                    Json.Decode.fail "Expecting an Any whose \"@type\" is a string"

                Ok url ->
                    if hasJsonForm url then
                        case pairValue "value" pairs of
                            Just json ->
                                Json.Decode.succeed (InternalAny.Any url (InJson json))

                            Nothing ->
                                Json.Decode.fail ("Expecting an Any of " ++ InternalAny.nameOf url ++ " to hold \"value\"")

                    else
                        pairs
                            |> List.filter (\( key, _ ) -> key /= "@type")
                            |> Json.Encode.object
                            |> InJson
                            |> InternalAny.Any url
                            |> Json.Decode.succeed


{-| The value under `key` among a JSON object's pairs.
-}
pairValue : String -> List ( String, a ) -> Maybe a
pairValue key pairs =
    case pairs of
        [] ->
            Nothing

        ( k, v ) :: rest ->
            if k == key then
                Just v

            else
                pairValue key rest


{-| Encode a `google.protobuf.Any`: the message's own JSON object with
`"@type"` added, or `{"@type": …, "value": …}` for a well-known type with a
JSON form of its own. An `Any` holding only binary is written as Connect
writes an error detail, `{"type": "notes.v1.Note", "value": "<base64>"}`,
which [`any`](#any) does not read. The empty `Any` (no type URL, as
`Proto.Message.default Proto.WellKnown.any`) is `{}`.
-}
encodeAny : Any -> Value
encodeAny (InternalAny.Any url payload) =
    let
        typed =
            ( "@type", Json.Encode.string url )
    in
    case payload of
        InJson json ->
            if hasJsonForm url then
                Json.Encode.object [ typed, ( "value", json ) ]

            else
                case Json.Decode.decodeValue (Json.Decode.keyValuePairs Json.Decode.value) json of
                    Ok pairs ->
                        Json.Encode.object (typed :: pairs)

                    Err _ ->
                        -- Only a hand-built record writes a message as other
                        -- than an object; this keeps its JSON whole.
                        Json.Encode.object [ typed, ( "value", json ) ]

        InBinary base64 ->
            if String.isEmpty url && String.isEmpty base64 then
                Json.Encode.object []

            else
                Json.Encode.object
                    [ ( "type", Json.Encode.string (InternalAny.nameOf url) )
                    , ( "value", Json.Encode.string base64 )
                    ]


{-| The well-known types whose proto3 JSON is not an object of their fields. An
`Any` holding one writes that form under `"value"`, beside `"@type"`.
-}
hasJsonForm : String -> Bool
hasJsonForm url =
    List.member (InternalAny.nameOf url)
        [ "google.protobuf.Any"
        , "google.protobuf.Timestamp"
        , "google.protobuf.Duration"
        , "google.protobuf.FieldMask"
        , "google.protobuf.Empty"
        , "google.protobuf.Struct"
        , "google.protobuf.Value"
        , "google.protobuf.ListValue"
        , "google.protobuf.DoubleValue"
        , "google.protobuf.FloatValue"
        , "google.protobuf.Int64Value"
        , "google.protobuf.UInt64Value"
        , "google.protobuf.Int32Value"
        , "google.protobuf.UInt32Value"
        , "google.protobuf.BoolValue"
        , "google.protobuf.StringValue"
        , "google.protobuf.BytesValue"
        ]
