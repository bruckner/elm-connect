{-| Decode one field of a message in a decoding pipeline. A missing key or a
JSON `null` gives the default, the field's proto3 zero value; any other value
must satisfy the decoder.

    type alias Note =
        { title : String, stars : Int }

    decodeNote : Decoder Note
    decodeNote =
        Json.Decode.succeed Note
            |> field "title" "" Proto.Json.Decode.string
            |> field "stars" 0 Proto.Json.Decode.int32

The value being decoded must be a JSON object.

The default says what absence means, so one step serves every field shape: a
field with presence (a message-typed or proto3 `optional` field) defaults to
`Nothing` and maps its decoder with `Just`, a repeated field defaults to `[]`
and decodes with `Json.Decode.list`.

    |> field "author" Nothing (Json.Decode.map Just decodeAuthor)
    |> field "tags" [] (Json.Decode.list Proto.Json.Decode.string)

-}
field : String -> a -> Decoder a -> Decoder (a -> b) -> Decoder b
field name default decoder =
    Json.Decode.map2 (|>) (valueAt [ name ] default decoder)


{-| [`field`](#field) for a field whose JSON name differs from its proto name:
the JSON name first, then the proto name. proto3 JSON parsers accept either
key, but not both: an object holding both fails, even when one of them is
`null`, as protobuf's own parsers reject a duplicate field.

    |> fieldEither "displayName" "display_name" "" Proto.Json.Decode.string

-}
fieldEither : String -> String -> a -> Decoder a -> Decoder (a -> b) -> Decoder b
fieldEither jsonName protoName default decoder =
    Json.Decode.map2 (|>) (valueAt (spellings jsonName protoName) default decoder)


{-| Decode a field of type `google.protobuf.Value`, held as a
`Maybe Proto.Value.Value`. A missing key gives `Nothing`. Any value under the
key gives `Just` it, `null` included: `null` is one of a `Value`'s own values,
so a field holding it is set, as protobuf's own parsers read it.

    type alias Setting =
        { name : String, value : Maybe Proto.Value.Value }

    decodeSetting : Decoder Setting
    decodeSetting =
        Json.Decode.succeed Setting
            |> field "name" "" Proto.Json.Decode.string
            |> valueField "value"

To encode one, `Nothing` leaves the field out and `Just` writes its JSON:

    objectOfFields [ ( "value", Maybe.map Proto.Value.toJson setting.value ) ]

-}
valueField : String -> Decoder (Maybe Proto.Value.Value -> b) -> Decoder b
valueField name =
    valueFieldEither name name


{-| [`valueField`](#valueField) for a field whose JSON name differs from its
proto name: the JSON name first, then the proto name, as in
[`fieldEither`](#fieldEither).
-}
valueFieldEither : String -> String -> Decoder (Maybe Proto.Value.Value -> b) -> Decoder b
valueFieldEither jsonName protoName =
    Json.Decode.map2 (|>) (jsonAt (spellings jsonName protoName))


{-| The JSON under whichever of `names`, the spellings of one field, the object
holds, `null` included; `Nothing` when it holds none of them.
-}
jsonAt : List String -> Decoder (Maybe Proto.Value.Value)
jsonAt names =
    Json.Decode.value
        |> Json.Decode.andThen
            (\object_ ->
                case spelledAs names object_ of
                    NotAnObject ->
                        Decode.notAnObject

                    Spelled (Err problem) ->
                        Json.Decode.fail problem

                    Spelled (Ok found) ->
                        checkedJson found
            )


{-| Decode a message without fields: any JSON object, usually `{}`, whatever
its keys. Anything else fails, as it does for a message with fields.

    decodePing : Decoder Ping
    decodePing =
        emptyMessage

-}
emptyMessage : Decoder {}
emptyMessage =
    Json.Decode.map (\() -> {}) Proto.Json.Decode.empty


{-| Decode a message: check that the JSON is an object, not an array, and
then run `fields`, a pipeline from `Json.Decode.succeed` with a
[`messageField`](#messageField) step per field. Anything that is not an
object fails as a [`field`](#field) step does, with elm/json's
`Expecting an OBJECT`.

    decodeNote : Decoder Note
    decodeNote =
        message
            (Json.Decode.succeed Note
                |> messageField "title" "" Proto.Json.Decode.string
                |> messageField "stars" 0 Proto.Json.Decode.int32
            )

A [`oneof`](#oneof) step reads the object as it does in any pipeline.

-}
message : Decoder a -> Decoder a
message fields =
    Json.Decode.value
        |> Json.Decode.andThen
            (\json ->
                if Decode.isObject json then
                    fields

                else
                    Decode.notAnObject
            )


{-| [`field`](#field) inside [`message`](#message), which has checked that the
JSON is an object: the step does not check it again. Outside `message` it may
read JSON that is not an object as a message, every field absent.
-}
messageField : String -> a -> Decoder a -> Decoder (a -> b) -> Decoder b
messageField name default decoder =
    Json.Decode.map2 (|>) (valueIn [ name ] default decoder)


{-| [`fieldEither`](#fieldEither) inside [`message`](#message), as
[`messageField`](#messageField) is `field`.
-}
messageFieldEither : String -> String -> a -> Decoder a -> Decoder (a -> b) -> Decoder b
messageFieldEither jsonName protoName default decoder =
    Json.Decode.map2 (|>) (valueIn (spellings jsonName protoName) default decoder)


{-| [`valueField`](#valueField) inside [`message`](#message), as
[`messageField`](#messageField) is `field`.
-}
messageValueField : String -> Decoder (Maybe Proto.Value.Value -> b) -> Decoder b
messageValueField name =
    messageValueFieldEither name name


{-| [`valueFieldEither`](#valueFieldEither) inside [`message`](#message), as
[`messageField`](#messageField) is `field`.
-}
messageValueFieldEither : String -> String -> Decoder (Maybe Proto.Value.Value -> b) -> Decoder b
messageValueFieldEither jsonName protoName =
    nestedMessageValueFieldEither jsonName protoName 0


{-| [`messageValueField`](#messageValueField) for a message that nests, at
`depth`, which the `Value` counts on from.
-}
nestedMessageValueField : String -> Int -> Decoder (Maybe Proto.Value.Value -> b) -> Decoder b
nestedMessageValueField name =
    nestedMessageValueFieldEither name name


{-| [`messageValueFieldEither`](#messageValueFieldEither) at a depth, as
[`nestedMessageValueField`](#nestedMessageValueField).
-}
nestedMessageValueFieldEither : String -> String -> Int -> Decoder (Maybe Proto.Value.Value -> b) -> Decoder b
nestedMessageValueFieldEither jsonName protoName depth =
    Json.Decode.map2 (|>)
        (Json.Decode.value
            |> Json.Decode.andThen
                (\object_ ->
                    case spelledInObject (spellings jsonName protoName) object_ of
                        Err problem ->
                            Json.Decode.fail problem

                        Ok found ->
                            nestedCheckedJson depth found
                )
        )


{-| [`valueAt`](#valueAt) for JSON already known to be an object, not an array.
-}
valueIn : List String -> a -> Decoder a -> Decoder a
valueIn names default decoder =
    Json.Decode.value
        |> Json.Decode.andThen
            (\object_ ->
                case spelledInObject names object_ of
                    Err problem ->
                        Json.Decode.fail problem

                    Ok Nothing ->
                        Json.Decode.succeed default

                    Ok (Just ( name, raw )) ->
                        if isNull raw then
                            Json.Decode.succeed default

                        else
                            Json.Decode.field name decoder
            )


{-| The value under whichever of `names`, the spellings of one field, the
object holds, decoded; `default` when it holds none of them or holds `null`.
-}
valueAt : List String -> a -> Decoder a -> Decoder a
valueAt names default decoder =
    Json.Decode.value
        |> Json.Decode.andThen
            (\object_ ->
                case spelledAs names object_ of
                    NotAnObject ->
                        Decode.notAnObject

                    Spelled (Err problem) ->
                        Json.Decode.fail problem

                    Spelled (Ok Nothing) ->
                        Json.Decode.succeed default

                    Spelled (Ok (Just ( name, raw ))) ->
                        if isNull raw then
                            Json.Decode.succeed default

                        else
                            Json.Decode.field name decoder
            )


{-| The keys a field may be written under: its JSON name, then its proto name
when that differs.
-}
spellings : String -> String -> List String
spellings jsonName protoName =
    if jsonName == protoName then
        [ jsonName ]

    else
        [ jsonName, protoName ]


{-| What a JSON value holds of one field: nothing when it is not an object;
otherwise which of the field's spellings it holds, with its value, or an error
naming them when it holds more than one.
-}
type Spelled
    = NotAnObject
    | Spelled (Result String (Maybe ( String, Value )))


{-| Which of `names`, the spellings of one field, the value holds.

`Json.Decode.field` finds a key with JavaScript's `in`, which takes constant
time, so a message of F fields costs O(F) to decode rather than reading the
whole object once per field. `in` also finds what an object inherits, which
for a JSON object is only `Object.prototype`'s properties, so a spelling that
names one of those is looked up among the object's own keys instead, as
`Json.Decode.dict` lists them, which takes time in their number. And `in`
finds an array's `length` and methods, so a key found is a field only when
the JSON is not an array.

-}
spelledAs : List String -> Value -> Spelled
spelledAs names json =
    case names of
        [ name ] ->
            if isInherited name then
                spelledAmongKeys names json

            else
                case probe name json of
                    Nothing ->
                        if Decode.isObject json then
                            Spelled (Ok Nothing)

                        else
                            NotAnObject

                    Just found ->
                        if Decode.isArray json then
                            NotAnObject

                        else
                            Spelled (Ok (Just found))

        _ ->
            if List.any isInherited names then
                spelledAmongKeys names json

            else
                spelledByProbes names json


{-| Which of `names` an object holds, found among its own keys.
-}
spelledAmongKeys : List String -> Value -> Spelled
spelledAmongKeys names json =
    case Json.Decode.decodeValue (Json.Decode.dict Json.Decode.value) json of
        Ok keys ->
            Spelled (oneSpelling names (List.filterMap (\name -> Dict.get name keys |> Maybe.map (Tuple.pair name)) names))

        Err _ ->
            NotAnObject


spelledByProbes : List String -> Value -> Spelled
spelledByProbes names json =
    case List.filterMap (\name -> probe name json) names of
        [] ->
            if Decode.isObject json then
                Spelled (Ok Nothing)

            else
                NotAnObject

        found ->
            if Decode.isArray json then
                NotAnObject

            else
                Spelled (oneSpelling names found)


oneSpelling : List String -> List ( String, Value ) -> Result String (Maybe ( String, Value ))
oneSpelling names found =
    case found of
        [] ->
            Ok Nothing

        [ one ] ->
            Ok (Just one)

        _ ->
            Err ("Expecting " ++ String.join " or " (List.map Decode.quote names) ++ ", but got both")


{-| The value under `name`, when JavaScript's `in` finds it in `json`.
-}
probe : String -> Value -> Maybe ( String, Value )
probe name json =
    case Json.Decode.decodeValue (Json.Decode.field name Json.Decode.value) json of
        Ok raw ->
            Just ( name, raw )

        Err _ ->
            Nothing


{-| Whether `name` is a property every object inherits from `Object.prototype`.
-}
isInherited : String -> Bool
isInherited name =
    case name of
        "__proto__" ->
            True

        "__defineGetter__" ->
            True

        "__defineSetter__" ->
            True

        "__lookupGetter__" ->
            True

        "__lookupSetter__" ->
            True

        "constructor" ->
            True

        "hasOwnProperty" ->
            True

        "isPrototypeOf" ->
            True

        "propertyIsEnumerable" ->
            True

        "toLocaleString" ->
            True

        "toString" ->
            True

        "valueOf" ->
            True

        _ ->
            False


isNull : Value -> Bool
isNull raw =
    case Json.Decode.decodeValue (Json.Decode.null ()) raw of
        Ok () ->
            True

        Err _ ->
            False


{-| A message's JSON object: each field that has a value, under its JSON name.
A field given `Nothing` is left out.

    objectOfFields
        [ ( "title", Just (Json.Encode.string "Hi") )
        , ( "author", Nothing )
        ]
    -- {"title":"Hi"}

-}
objectOfFields : List ( String, Maybe Value ) -> Value
objectOfFields fields =
    presentPairs fields [] False


{-| The pairs of the fields that have a value, gathered in reverse in one
pass, noting whether a key is `__proto__`, and made an object.
-}
presentPairs : List ( String, Maybe Value ) -> List ( String, Value ) -> Bool -> Value
presentPairs fields done proto =
    case fields of
        [] ->
            objectOfReversed proto done

        ( key, Just json ) :: rest ->
            presentPairs rest (( key, json ) :: done) (proto || key == "__proto__")

        ( _, Nothing ) :: rest ->
            presentPairs rest done proto


{-| [`objectOf`](#objectOf) of pairs given in reverse, told whether a key is
`__proto__`.
-}
objectOfReversed : Bool -> List ( String, Value ) -> Value
objectOfReversed proto reversed =
    if proto then
        objectOf (List.reverse reversed)

    else
        Json.Encode.object (List.reverse reversed)


{-| A JSON object from its pairs, keys kept in order. `Json.Encode.object`
assigns each pair to a JavaScript object, and assigning `__proto__` sets the
object's prototype rather than a property, so that key would be lost from the
output while `JSON.parse` reads it as a property. An object with it is built
as text and parsed, which keeps it.
-}
objectOf : List ( String, Value ) -> Value
objectOf pairs =
    if List.any (\( key, _ ) -> key == "__proto__") pairs then
        pairs
            |> List.map
                (\( key, json ) ->
                    Json.Encode.encode 0 (Json.Encode.string key)
                        ++ ":"
                        ++ Json.Encode.encode 0 json
                )
            |> String.join ","
            |> (\body -> "{" ++ body ++ "}")
            |> Json.Decode.decodeString Json.Decode.value
            |> Result.withDefault (Json.Encode.object pairs)

    else
        Json.Encode.object pairs


{-| A field without presence: `Nothing` when it holds its proto3 default, the
first argument, else its JSON. For a string, a number held as an `Int`, a
64-bit integer held as its decimal string, a `Bool`, bytes held as base64 or an
enum; a `Float` uses [`implicitFloatField`](#implicitFloatField), and bytes held as `Bytes`
[`implicitBytesField`](#implicitBytesField).

    implicitField "" Json.Encode.string "" -- Nothing

    implicitField 0 Json.Encode.int 3 -- Just 3

-}
implicitField : a -> (a -> Value) -> a -> Maybe Value
implicitField zero write held =
    if held == zero then
        Nothing

    else
        Just (write held)


{-| A `bytes` field held as `Bytes`, without presence: `Nothing` when it holds
no bytes, else its JSON as [`encodeBytesAsBytes`](#encodeBytesAsBytes) writes
it. Not [`implicitField`](#implicitField), which compares with `==`, and `==` finds any
two `Bytes` equal.
-}
implicitBytesField : Bytes -> Maybe Value
implicitBytesField held =
    if Bytes.width held == 0 then
        Nothing

    else
        Just (encodeBytesAsBytes held)


{-| A `double` or `float` field without presence: `Nothing` at `0`, else its
JSON as [`encodeFloat`](#encodeFloat) writes it. `-0`, NaN and the infinities
are not the default and are written; `-0` as `0`, since JavaScript's JSON
writer has no negative zero, and a server reads `+0` either way.
-}
implicitFloatField : Float -> Maybe Value
implicitFloatField number =
    if number == 0 && 1 / number > 0 then
        Nothing

    else
        Just (encodeFloat number)


{-| A repeated field: `Nothing` when empty, else a JSON array of its elements.
-}
repeatedField : (a -> Value) -> List a -> Maybe Value
repeatedField write values =
    if List.isEmpty values then
        Nothing

    else
        Just (Json.Encode.list write values)


{-| A map field: `Nothing` when empty, else a JSON object, keyed as
`Json.Encode.dict` keys it. A key of `__proto__` is kept as an ordinary key.
-}
dictField : (k -> String) -> (v -> Value) -> Dict.Dict k v -> Maybe Value
dictField key write entries =
    if Dict.isEmpty entries then
        Nothing

    else
        entries
            |> Dict.toList
            |> List.map (\( k, v ) -> ( key k, write v ))
            |> objectOf
            |> Just


{-| A map field with `bool` keys: `Nothing` when empty, else the object
[`encodeBoolMap`](#encodeBoolMap) writes.
-}
boolMapField : (a -> Value) -> List ( Bool, a ) -> Maybe Value
boolMapField write pairs =
    if List.isEmpty pairs then
        Nothing

    else
        Just (encodeBoolMap write pairs)


{-| A field with presence of a message that holds nothing a write can refuse:
`Nothing` when `Nothing`, else its encoder's JSON ([`Proto.Json.Encode.encodeTotal`](Proto-Json-Encode#encodeTotal)).
-}
totalOptionalField : (a -> Encoder Never) -> Maybe a -> Maybe Value
totalOptionalField write held =
    case held of
        Just present ->
            Just (Encoder.total (write present))

        Nothing ->
            Nothing


{-| [`repeatedField`](#repeatedField) of a message that holds nothing a write
can refuse.
-}
totalRepeatedField : (a -> Encoder Never) -> List a -> Maybe Value
totalRepeatedField write values =
    if List.isEmpty values then
        Nothing

    else
        Just (Json.Encode.list (\item -> Encoder.total (write item)) values)


{-| [`dictField`](#dictField) of a message that holds nothing a write can
refuse.
-}
totalDictField : (k -> String) -> (v -> Encoder Never) -> Dict.Dict k v -> Maybe Value
totalDictField key write entries =
    dictField key (\item -> Encoder.total (write item)) entries


{-| [`boolMapField`](#boolMapField) of a message that holds nothing a write
can refuse.
-}
totalBoolMapField : (a -> Encoder Never) -> List ( Bool, a ) -> Maybe Value
totalBoolMapField write pairs =
    boolMapField (\item -> Encoder.total (write item)) pairs


{-| Decode a oneof in a decoding pipeline: unlike [`field`](#field), the
decoder reads the message object itself, since each member of a oneof is a
key of the message. The decoder is usually [`members`](#members).

    type NoteKind
        = NoteKindUnset
        | NoteKindText String

    decodeNote : Decoder Note
    decodeNote =
        Json.Decode.succeed Note
            |> field "title" "" Proto.Json.Decode.string
            |> oneof decodeNoteKind

-}
oneof : Decoder a -> Decoder (a -> b) -> Decoder b
oneof decoder =
    Json.Decode.map2 (|>) decoder


{-| Decode a oneof from the message object, given the oneof's proto name (for
error messages), its unset value and its members:

    decodeNoteKind : Decoder NoteKind
    decodeNoteKind =
        members "kind"
            NoteKindUnset
            [ member "text" (Json.Decode.map NoteKindText Proto.Json.Decode.string)
            , memberEither "pageCount" "page_count" (Json.Decode.map NoteKindPageCount Proto.Json.Decode.int32)
            ]

A member is present when the object holds its key with a value other than
`null`, which proto3 JSON reads as absent; a [`valueMember`](#valueMember) is
present when it holds `null` too. Then:

  - no member present decodes as the unset value;
  - one member present decodes as that member, and when its value does not
    satisfy the member's decoder the oneof fails, and with it the message;
  - more than one member present fails, naming the keys found:
    `Expecting at most one member of oneof "kind", but got "text" and "pageCount"`.

A member written under both its JSON name and its proto name fails, as a field
does in [`fieldEither`](#fieldEither).

-}
members : String -> a -> List (Member a) -> Decoder a
members oneofName unset candidates =
    Json.Decode.value
        |> Json.Decode.andThen
            (\object_ ->
                case presentMembers object_ candidates of
                    Nothing ->
                        Decode.notAnObject

                    Just (Err problem) ->
                        Json.Decode.fail problem

                    Just (Ok []) ->
                        Json.Decode.succeed unset

                    Just (Ok [ ( name, decoder ) ]) ->
                        Json.Decode.field name decoder

                    Just (Ok several) ->
                        Json.Decode.fail
                            ("Expecting at most one member of oneof "
                                ++ Decode.quote oneofName
                                ++ ", but got "
                                ++ listing (List.map (\( name, _ ) -> Decode.quote name) several)
                            )
            )


{-| The members the object holds, each with the key it is written under;
`Nothing` when the JSON is not an object.
-}
presentMembers : Value -> List (Member a) -> Maybe (Result String (List ( String, Decoder a )))
presentMembers json candidates =
    if Decode.isObject json then
        Just (presentIn json candidates [])

    else
        Nothing


presentIn : Value -> List (Member a) -> List ( String, Decoder a ) -> Result String (List ( String, Decoder a ))
presentIn json candidates found =
    case candidates of
        [] ->
            Ok (List.reverse found)

        (Member candidate) :: rest ->
            case spelledInObject candidate.names json of
                Ok (Just ( name, raw )) ->
                    if isNull raw && not candidate.nullIsSet then
                        presentIn json rest found

                    else
                        presentIn json rest (( name, candidate.decoder ) :: found)

                Ok Nothing ->
                    presentIn json rest found

                Err problem ->
                    Err problem


{-| [`spelledAs`](#spelledAs) for JSON already known to be an object, not an
array: its shape is not tested again.
-}
spelledInObject : List String -> Value -> Result String (Maybe ( String, Value ))
spelledInObject names json =
    case names of
        [ name ] ->
            if isInherited name then
                spelledAmongOwnKeys names json

            else
                Ok (probe name json)

        _ ->
            if List.any isInherited names then
                spelledAmongOwnKeys names json

            else
                oneSpelling names (List.filterMap (\name -> probe name json) names)


spelledAmongOwnKeys : List String -> Value -> Result String (Maybe ( String, Value ))
spelledAmongOwnKeys names json =
    case spelledAmongKeys names json of
        Spelled found ->
            found

        NotAnObject ->
            Ok Nothing


{-| `"a" and "b"`, `"a", "b" and "c"`.
-}
listing : List String -> String
listing items =
    case List.reverse items of
        last :: ((_ :: _) as before) ->
            String.join ", " (List.reverse before) ++ " and " ++ last

        _ ->
            String.concat items


{-| One member of a oneof, for [`members`](#members): the keys it may be
written under and the decoder of its value.
-}
type Member a
    = Member
        { names : List String
        , nullIsSet : Bool
        , decoder : Decoder a
        }


{-| A member of a oneof: its key and the decoder of its value. A `null` value
reads as absent.

    member "text" (Json.Decode.map NoteKindText Proto.Json.Decode.string)

-}
member : String -> Decoder a -> Member a
member name =
    memberEither name name


{-| [`member`](#member) for a member whose JSON name differs from its proto
name: the JSON name first, then the proto name, as in
[`fieldEither`](#fieldEither).
-}
memberEither : String -> String -> Decoder a -> Member a
memberEither jsonName protoName decoder =
    Member { names = spellings jsonName protoName, nullIsSet = False, decoder = decoder }


{-| A member of type `google.protobuf.Empty`, whose constructor carries
nothing: present when its key holds an object (usually `{}`). `null` reads as
absent, and any other value fails.

    type ActionKind
        = ActionKindUnset
        | ActionKindClear

    decodeActionKind : Decoder ActionKind
    decodeActionKind =
        members "kind" ActionKindUnset [ emptyMember "clear" ActionKindClear ]

-}
emptyMember : String -> a -> Member a
emptyMember name =
    emptyMemberEither name name


{-| [`emptyMember`](#emptyMember) for a member whose JSON name differs from its
proto name: the JSON name first, then the proto name.
-}
emptyMemberEither : String -> String -> a -> Member a
emptyMemberEither jsonName protoName constructor =
    memberEither jsonName protoName (Json.Decode.map (\_ -> constructor) Proto.Json.Decode.empty)


{-| A member of type `google.protobuf.Value`, given its constructor. Its value
is any JSON, `null` included: unlike every other member, one present as `null`
is set and holds the JSON `null`, as protobuf's own parsers read it.

    valueMember "payload" NoteKindPayload

-}
valueMember : String -> (Proto.Value.Value -> a) -> Member a
valueMember name =
    valueMemberEither name name


{-| [`valueMember`](#valueMember) for a member whose JSON name differs from its
proto name: the JSON name first, then the proto name.
-}
valueMemberEither : String -> String -> (Proto.Value.Value -> a) -> Member a
valueMemberEither jsonName protoName =
    nestedValueMemberEither jsonName protoName 0


{-| [`valueMember`](#valueMember) for a oneof of a message at `depth` whose
decoder counts the levels of nesting, which the `Value`'s arrays and objects
count on from.
-}
nestedValueMember : String -> Int -> (Proto.Value.Value -> a) -> Member a
nestedValueMember name =
    nestedValueMemberEither name name


{-| [`valueMemberEither`](#valueMemberEither) at a depth, as
[`nestedValueMember`](#nestedValueMember).
-}
nestedValueMemberEither : String -> String -> Int -> (Proto.Value.Value -> a) -> Member a
nestedValueMemberEither jsonName protoName depth constructor =
    Member
        { names = spellings jsonName protoName
        , nullIsSet = True
        , decoder = Json.Decode.map constructor (Decode.nestedValue depth)
        }


{-| A member of the enum `google.protobuf.NullValue`, whose constructor carries
nothing: present when its key holds `null`, which proto3 JSON writes for it, or
the value's name or number, as [`Proto.Json.Decode.nullValue`](Proto-Json-Decode#nullValue) reads them. Unlike
every member but a [`valueMember`](#valueMember), one present as `null` is set.

    type ActionKind
        = ActionKindUnset
        | ActionKindNothing

    decodeActionKind : Decoder ActionKind
    decodeActionKind =
        members "kind" ActionKindUnset [ nullValueMember "nothing" ActionKindNothing ]

-}
nullValueMember : String -> a -> Member a
nullValueMember name =
    nullValueMemberEither name name


{-| [`nullValueMember`](#nullValueMember) for a member whose JSON name differs
from its proto name: the JSON name first, then the proto name.
-}
nullValueMemberEither : String -> String -> a -> Member a
nullValueMemberEither jsonName protoName constructor =
    Member
        { names = spellings jsonName protoName
        , nullIsSet = True
        , decoder = Json.Decode.map (\() -> constructor) Proto.Json.Decode.nullValue
        }


{-| Decode an enum, given its proto name, its zero value and a row per value
name: the name, its number and its constructor. proto3 JSON writes an enum as
its value's name, and a parser must also accept the number.

A number the rows do not hold, such as one added to the server's proto after
this client was generated, decodes as the zero value. A name the rows do not
hold fails, as protobuf's own parsers do:
`Expecting a value of enum "Status"`, the name it got beside the text in
elm/json's failure; for a decoder
that reads it as the zero value instead, see [`enumOrZero`](#enumOrZero).

    type Status
        = StatusUnspecified
        | StatusActive

    decodeStatus : Decoder Status
    decodeStatus =
        enum "Status"
            StatusUnspecified
            [ ( "STATUS_UNSPECIFIED", 0, StatusUnspecified )
            , ( "STATUS_ACTIVE", 1, StatusActive )
            , ( "STATUS_LIVE", 1, StatusActive )
            ]

An alias (`allow_alias`) is a second row for the same constructor, so both
names decode to it. When two rows share a name or a number, the first wins.

-}
enum : String -> a -> List ( String, Int, a ) -> Decoder a
enum enumName zero values =
    Decode.enumWith
        (\text -> Json.Decode.fail ("Expecting a value of enum " ++ Decode.quote enumName))
        zero
        values


{-| Decode an enum as [`enum`](#enum) does, with the same arguments, except
that a name the rows do not hold decodes as the zero value too, as an unknown
number does. Nothing a JSON string or integer holds fails; anything else (a
fraction, a boolean, an object) still does, with elm/json's own error. No
failure names the enum, so its name goes unused; it is taken so the two read
alike. Code generated with `enum_unknown=zero` calls this one.

It suits a client that outlives the server's deploys: a value the server adds
reaches it as a name, and with `enum` that fails the whole message it is in.
The zero value is the one proto3 reserves for "unspecified", which is what
makes reading it here sound, but the distinction is dropped: the client cannot
tell the value it does not know from the zero value, and re-encoding sends the
zero value's name.

-}
enumOrZero : String -> a -> List ( String, Int, a ) -> Decoder a
enumOrZero _ zero values =
    Decode.enumWith (\_ -> Json.Decode.succeed zero) zero values


{-| Decode a map with `string` keys, each key as [`Proto.Json.Decode.string`](Proto-Json-Decode#string) reads a
value: one holding a UTF-16 surrogate without its pair fails.
-}
stringDict : Decoder a -> Decoder (Dict.Dict String a)
stringDict decoder =
    Json.Decode.dict decoder
        |> Json.Decode.andThen
            (\dict ->
                if Dict.foldl (\key _ ok -> ok && Decode.isScalarText key) True dict then
                    Json.Decode.succeed dict

                else
                    Json.Decode.fail "Expecting a map key of Unicode text, but got one with a UTF-16 surrogate without its pair"
            )


{-| Decode a map with signed 32-bit integer keys (`int32`, `sint32`,
`sfixed32`). JSON object keys are strings, so proto3 JSON writes each key as
its decimal string. A key is an integer written as an `int64` string may be,
in decimal or exponent notation, within -2147483648 to 2147483647: `"7"`,
`"-7"`, `"1e2"`, and `"07"`, whose leading zero protobuf's own parsers accept
too. Any other key fails, such as `"abc"`, `"1.5"`, `"+5"` or `"2147483648"`,
and so do two keys that name one integer, such as `"7"` and `"07"`.

    Json.Decode.decodeString (int32Dict Proto.Json.Decode.string) """{"1":"a","-2":"b"}"""
    -- Ok (Dict.fromList [ ( -2, "b" ), ( 1, "a" ) ])

Encode one with `Json.Encode.dict String.fromInt`.

-}
int32Dict : Decoder a -> Decoder (Dict.Dict Int a)
int32Dict =
    keyedDict (boundedKey "an int32 map key (-2147483648 to 2147483647)" -2147483648 2147483647)


{-| Decode a map with unsigned 32-bit integer keys (`uint32`, `fixed32`): the
keys [`int32Dict`](#int32Dict) accepts, within 0 to 4294967295.
-}
uint32Dict : Decoder a -> Decoder (Dict.Dict Int a)
uint32Dict =
    keyedDict (boundedKey "a uint32 map key (0 to 4294967295)" 0 4294967295)


{-| Decode a map with signed 64-bit integer keys (`int64`, `sint64`,
`sfixed64`), keyed by decimal strings as [`Proto.Json.Decode.int64`](Proto-Json-Decode#int64) holds its values,
whatever the `int64` option. A key is read as `int64` reads a string, within
-9223372036854775808 to 9223372036854775807, and held in its canonical form:
`"007"` is the key `"7"`, `"1e3"` the key `"1000"`. Any other key fails, such
as `"abc"`, `"1.5"` or `"9223372036854775808"`, and so do two keys that name
one integer, such as `"7"` and `"007"`.

    Json.Decode.decodeString (int64Dict Proto.Json.Decode.string) """{"007":"a","-2":"b"}"""
    -- Ok (Dict.fromList [ ( "-2", "b" ), ( "7", "a" ) ])

Encode one with `Json.Encode.dict identity`.

-}
int64Dict : Decoder a -> Decoder (Dict.Dict String a)
int64Dict =
    keyedDict (wideKey "an int64 map key" Decode.Signed)


{-| Decode a map with unsigned 64-bit integer keys (`uint64`, `fixed64`): the
keys [`int64Dict`](#int64Dict) accepts, within 0 to 18446744073709551615
(2^64 - 1).
-}
uint64Dict : Decoder a -> Decoder (Dict.Dict String a)
uint64Dict =
    keyedDict (wideKey "a uint64 map key" Decode.Unsigned)


{-| A map whose keys `readKey` reads from their text, failing on a key it
rejects and on two keys it reads as one.
-}
keyedDict : (String -> Result String comparable) -> Decoder a -> Decoder (Dict.Dict comparable a)
keyedDict readKey decoder =
    Json.Decode.keyValuePairs decoder
        |> Json.Decode.andThen (\pairs -> fromResult (insertKeys readKey Dict.empty Dict.empty pairs))


insertKeys : (String -> Result String comparable) -> Dict.Dict comparable String -> Dict.Dict comparable a -> List ( String, a ) -> Result String (Dict.Dict comparable a)
insertKeys readKey seen entries pairs =
    case pairs of
        [] ->
            Ok entries

        ( text, entry ) :: rest ->
            case readKey text of
                Err problem ->
                    Err problem

                Ok key ->
                    case Dict.get key seen of
                        Just earlier ->
                            Err "Expecting distinct map keys"

                        Nothing ->
                            insertKeys readKey (Dict.insert key text seen) (Dict.insert key entry entries) rest


{-| A 32-bit integer map key within `low` to `high`, read as an `int64` string
is.
-}
boundedKey : String -> Int -> Int -> String -> Result String Int
boundedKey what low high text =
    Decode.narrowInteger low high text
        |> Result.mapError (\_ -> "Expecting " ++ what)


{-| A 64-bit integer map key in its canonical decimal form, within the range
of `width`.
-}
wideKey : String -> Decode.Width -> String -> Result String String
wideKey what width text =
    Decode.wideInteger width text
        |> Result.mapError (\_ -> "Expecting " ++ what ++ " " ++ Decode.widthRange width)


{-| Decode a map with `bool` keys as an association list, since Elm's `Bool`
is not `comparable` and so cannot key a `Dict`. proto3 JSON writes each key as
`"true"` or `"false"`; any other key fails. The pairs come in the object's key
order, and a map has at most two.

    Json.Decode.decodeString (boolMap Proto.Json.Decode.string) """{"true":"on","false":"off"}"""
    -- Ok [ ( True, "on" ), ( False, "off" ) ]

-}
boolMap : Decoder a -> Decoder (List ( Bool, a ))
boolMap decoder =
    Json.Decode.keyValuePairs decoder
        |> Json.Decode.andThen
            (\pairs ->
                List.foldr
                    (\( key, entry ) result ->
                        Result.map2 (\bool rest -> ( bool, entry ) :: rest)
                            (boolKey key)
                            result
                    )
                    (Ok [])
                    pairs
                    |> fromResult
            )


boolKey : String -> Result String Bool
boolKey key =
    case key of
        "true" ->
            Ok True

        "false" ->
            Ok False

        _ ->
            Err "Expecting a bool map key (\"true\" or \"false\")"


fromResult : Result String a -> Decoder a
fromResult result =
    case result of
        Ok decoded ->
            Json.Decode.succeed decoded

        Err problem ->
            Json.Decode.fail problem


{-| Encode a map with `bool` keys, held as an association list, as a JSON
object keyed `"true"` and `"false"`. When a key appears twice, the later pair
is the one a parser keeps.

    encodeBoolMap Json.Encode.string [ ( True, "on" ) ] -- {"true":"on"}

-}
encodeBoolMap : (a -> Value) -> List ( Bool, a ) -> Value
encodeBoolMap write pairs =
    pairs
        |> List.map
            (\( key, entry ) ->
                ( if key then
                    "true"

                  else
                    "false"
                , write entry
                )
            )
        |> Json.Encode.object


{-| Encode a 64-bit integer, held as its decimal string, as proto3 JSON does:
as a JSON string.
-}
encodeInt64 : String -> Value
encodeInt64 =
    Json.Encode.string


{-| Encode a 64-bit integer held as an `Int` as proto3 JSON writes one: its
decimal string, as a JSON string.

    encodeInt64AsInt 42 -- "42"

-}
encodeInt64AsInt : Int -> Value
encodeInt64AsInt int =
    Json.Encode.string (Proto.Int64.fromInt int)


{-| Encode a `double` or `float`: a finite value as a JSON number, NaN and the
infinities as the strings proto3 JSON uses for them.
-}
encodeFloat : Float -> Value
encodeFloat number =
    if isNaN number then
        Json.Encode.string "NaN"

    else if isInfinite number then
        if number > 0 then
            Json.Encode.string "Infinity"

        else
            Json.Encode.string "-Infinity"

    else
        Json.Encode.float number


{-| Encode `bytes`, held as a base64 string, as that string, unchecked.
-}
encodeBytes : String -> Value
encodeBytes =
    Json.Encode.string


{-| Encode `bytes` held as `Bytes` as base64 text: the standard alphabet, with
`=` padding, as proto3 JSON writes it.
-}
encodeBytesAsBytes : Bytes -> Value
encodeBytesAsBytes data =
    Json.Encode.string (Proto.Bytes.toBase64 data)


{-| Encode a `google.protobuf.Empty` as `{}`.
-}
encodeEmpty : () -> Value
encodeEmpty () =
    Json.Encode.object []


{-| Encode the enum `google.protobuf.NullValue` as proto3 JSON writes it,
`null`.
-}
encodeNullValue : () -> Value
encodeNullValue () =
    Json.Encode.null


{-| A field of type `Value` found by its key, read as [`Proto.Json.Decode.value`](Proto-Json-Decode#value)
reads one.
-}
checkedJson : Maybe ( String, Value ) -> Decoder (Maybe Proto.Value.Value)
checkedJson =
    nestedCheckedJson 0


nestedCheckedJson : Int -> Maybe ( String, Value ) -> Decoder (Maybe Proto.Value.Value)
nestedCheckedJson depth found =
    case found of
        Just ( name, _ ) ->
            Json.Decode.field name (Json.Decode.map Just (Decode.nestedValue depth))

        Nothing ->
            Json.Decode.succeed Nothing



-- MESSAGES THAT NEST


{-| The decoder at a depth of a message on a cycle, the outermost message at 1,
from the decoder `build` makes for a depth. `memo build` makes
the decoders for depths 1 to 100 once, so applied in a top-level value, as
generated code applies it, it makes them once per program, and a read looks
its decoder up; past 100 the decoder fails.

    decodeNestedNode =
        Proto.Json.memo (\depth -> ...)

-}
memo : (Int -> Decoder a) -> Int -> Decoder a
memo build =
    let
        table =
            Array.initialize Depth.limit (\index -> build (index + 1))
    in
    \depth ->
        case Array.get (depth - 1) table of
            Just decoder ->
                decoder

            Nothing ->
                Depth.tooDeep


{-| A message on no cycle that nests and takes the registry, read by a message
at `depth`: its decoder one level deeper, built from `build` when this is, or
past 100 levels failing. A holder's decoder that takes the registry is built
as it is read, so this builds the message's once per read of its holder.

    Proto.Json.deeper depth (decodeNestedNoteWith types)

-}
deeper : Int -> (Int -> Decoder a) -> Decoder a
deeper depth build =
    if depth < Depth.limit then
        build (depth + 1)

    else
        Depth.tooDeep


{-| A message that nests, read by a message at `depth`: its decoder one level
deeper, built from `build` as the value is read, or past 100 levels failing.
A message on a cycle that takes the registry is read so, since its decoder
cannot be built before the registry is given; so is a message on no cycle
that takes none, whose decoder built when its holder's is would be built
once for every path to it.

    Proto.Json.deeperWith depth (decodeNestedNodeWith types)

    Proto.Json.deeperWith depth decodeNestedNote

-}
deeperWith : Int -> (Int -> Decoder a) -> Decoder a
deeperWith depth build =
    Json.Decode.lazy
        (\_ ->
            if depth < Depth.limit then
                build (depth + 1)

            else
                Depth.tooDeep
        )


{-| A `google.protobuf.Struct` held by a message that nests, read as
[`Proto.Json.Decode.struct`](Proto-Json-Decode#struct) reads one at the
message's depth: the object is one level deeper.
-}
nestedStruct : Int -> Decoder (Dict.Dict String Proto.Value.Value)
nestedStruct =
    Decode.nestedStruct


{-| A `google.protobuf.ListValue` held by a message that nests, read as
[`Proto.Json.Decode.listValue`](Proto-Json-Decode#listValue) reads one at the
message's depth.
-}
nestedListValue : Int -> Decoder (List Proto.Value.Value)
nestedListValue =
    Decode.nestedListValue


{-| A `google.protobuf.Value` held by a message that nests, read as
[`Proto.Json.Decode.value`](Proto-Json-Decode#value) reads one at the
message's depth: its arrays and objects are a level deeper each.
-}
nestedValue : Int -> Decoder Proto.Value.Value
nestedValue =
    Decode.nestedValue


{-| [`Proto.Json.Decode.anyWith`](Proto-Json-Decode#anyWith) for an `Any` held by a message at `depth`: the `Any`, and what it holds, count on from there.
-}
nestedAnyWith : Int -> Registry -> Decoder Any
nestedAnyWith depth registry =
    Proto.Json.Decode.anyWith (InternalRegistry.atLeast depth registry)


{-| How deep the read a registry was passed to has nested, where a message
inside an `Any` starts counting.
-}
registryDepth : Registry -> Int
registryDepth =
    InternalRegistry.depthOf
