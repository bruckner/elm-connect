{
    "type": "package",
    "name": "bruckner/elm-connect",
    "summary": "Call Connect RPC and google.api.http REST APIs from protobuf-generated Elm",
    "license": "MIT",
    "version": "0.1.0",
    "exposed-modules": [
        "Rpc",
        "Rpc.Call",
        "Rpc.Route",
        "Rpc.Code",
        "Rpc.Error",
        "Rpc.Transport",
        "Rpc.Retry",
        "Rpc.Trace",
        "Rpc.Body",
        "Rpc.Request",
        "Rpc.Response",
        "Proto.Http",
        "Proto.Message",
        "Proto.Field",
        "Proto.Enum",
        "Proto.EnumValue",
        "Proto.Method",
        "Proto.Registry",
        "Proto.WellKnown",
        "Proto.Any",
        "Proto.Json",
        "Proto.Int64",
        "Proto.Bytes",
        "Proto.Duration",
        "Proto.Timestamp",
        "Proto.Version"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/bytes": "1.0.0 <= v < 2.0.0",
        "elm/core": "1.0.0 <= v < 2.0.0",
        "elm/http": "2.0.0 <= v < 3.0.0",
        "elm/json": "1.1.4 <= v < 2.0.0",
        "elm/time": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.0.0 <= v < 3.0.0"
    }
}
