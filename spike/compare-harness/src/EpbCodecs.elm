module EpbCodecs exposing (binaryEchoes, jsonEchoes, table)

{-| eriktim/elm-protocol-buffers' codecs of the reduced codec corpus,
generated by protoc-gen-elm (`grpc=false,json`) into spike/compare/gen.
-}

import Bytes exposing (Bytes)
import Dict exposing (Dict)
import Entry exposing (Entry)
import Json.Decode
import Json.Encode
import Proto.Codec.V1 as V1
import Protobuf.Decode
import Protobuf.Encode


entry : Json.Decode.Decoder a -> (a -> Json.Encode.Value) -> Protobuf.Decode.Decoder a -> (a -> Protobuf.Encode.Encoder) -> Entry
entry decoder encode decoderBytes encodeBytes =
    { decodeJson = \input -> Json.Decode.decodeString decoder input |> Result.toMaybe |> isJust
    , decodeBinary = \input -> Protobuf.Decode.decode decoderBytes input |> isJust
    , prepareJson =
        \input ->
            Json.Decode.decodeString decoder input
                |> Result.toMaybe
                |> Maybe.map (\value () -> Json.Encode.encode 0 (encode value))
    , prepareBinary =
        \input ->
            Protobuf.Decode.decode decoderBytes input
                |> Maybe.map (\value () -> Protobuf.Encode.encode (encodeBytes value))
    , toBinary =
        \input ->
            Json.Decode.decodeString decoder input
                |> Result.toMaybe
                |> Maybe.map (encodeBytes >> Protobuf.Encode.encode)
    , binaryEcho = \input -> Protobuf.Decode.decode decoderBytes input |> Maybe.map (encodeBytes >> Protobuf.Encode.encode)
    , jsonError =
        \input ->
            case Json.Decode.decodeString decoder input of
                Ok _ ->
                    Nothing

                Err problem ->
                    Just (String.replace "\n" " " (String.right 160 (Json.Decode.errorToString problem)))
    , jsonEcho = \input -> Json.Decode.decodeString decoder input |> Result.toMaybe |> Maybe.map (encode >> Json.Encode.encode 0)
    }


isJust : Maybe a -> Bool
isJust m =
    case m of
        Just _ ->
            True

        Nothing ->
            False


table : Dict String Entry
table =
    Dict.fromList
        [ ( "codec.v1.Scalars", entry V1.jsonDecodeScalars V1.jsonEncodeScalars V1.decodeScalars V1.encodeScalars )
        , ( "codec.v1.Optionals", entry V1.jsonDecodeOptionals V1.jsonEncodeOptionals V1.decodeOptionals V1.encodeOptionals )
        , ( "codec.v1.Repeated", entry V1.jsonDecodeRepeated V1.jsonEncodeRepeated V1.decodeRepeated V1.encodeRepeated )
        , ( "codec.v1.Maps", entry V1.jsonDecodeMaps V1.jsonEncodeMaps V1.decodeMaps V1.encodeMaps )
        , ( "codec.v1.Choice", entry V1.jsonDecodeChoice V1.jsonEncodeChoice V1.decodeChoice V1.encodeChoice )
        , ( "codec.v1.Names", entry V1.jsonDecodeNames V1.jsonEncodeNames V1.decodeNames V1.encodeNames )
        , ( "codec.v1.Outer", entry V1.jsonDecodeOuter V1.jsonEncodeOuter V1.decodeOuter V1.encodeOuter )
        , ( "codec.v1.Tree", entry V1.jsonDecodeTree V1.jsonEncodeTree V1.decodeTree V1.encodeTree )
        , ( "codec.v1.WellKnown", entry V1.jsonDecodeWellKnown V1.jsonEncodeWellKnown V1.decodeWellKnown V1.encodeWellKnown )
        , ( "codec.v1.Wrappers", entry V1.jsonDecodeWrappers V1.jsonEncodeWrappers V1.decodeWrappers V1.encodeWrappers )
        , ( "codec.v1.Across", entry V1.jsonDecodeAcross V1.jsonEncodeAcross V1.decodeAcross V1.encodeAcross )
        , ( "codec.v1.Leaf", entry V1.jsonDecodeLeaf V1.jsonEncodeLeaf V1.decodeLeaf V1.encodeLeaf )
        , ( "codec.v1.Everything", entry V1.jsonDecodeEverything V1.jsonEncodeEverything V1.decodeEverything V1.encodeEverything )
        ]


{-| The binary codecs alone, for the size programs: what DCE keeps of a
record is the whole record, so `table` would keep both formats.
-}
binaryEchoes : Dict String (Bytes -> Maybe Bytes)
binaryEchoes =
    Dict.fromList
        [ ( "codec.v1.Scalars", \input -> Protobuf.Decode.decode V1.decodeScalars input |> Maybe.map (V1.encodeScalars >> Protobuf.Encode.encode) )
        , ( "codec.v1.Optionals", \input -> Protobuf.Decode.decode V1.decodeOptionals input |> Maybe.map (V1.encodeOptionals >> Protobuf.Encode.encode) )
        , ( "codec.v1.Repeated", \input -> Protobuf.Decode.decode V1.decodeRepeated input |> Maybe.map (V1.encodeRepeated >> Protobuf.Encode.encode) )
        , ( "codec.v1.Maps", \input -> Protobuf.Decode.decode V1.decodeMaps input |> Maybe.map (V1.encodeMaps >> Protobuf.Encode.encode) )
        , ( "codec.v1.Choice", \input -> Protobuf.Decode.decode V1.decodeChoice input |> Maybe.map (V1.encodeChoice >> Protobuf.Encode.encode) )
        , ( "codec.v1.Names", \input -> Protobuf.Decode.decode V1.decodeNames input |> Maybe.map (V1.encodeNames >> Protobuf.Encode.encode) )
        , ( "codec.v1.Outer", \input -> Protobuf.Decode.decode V1.decodeOuter input |> Maybe.map (V1.encodeOuter >> Protobuf.Encode.encode) )
        , ( "codec.v1.Tree", \input -> Protobuf.Decode.decode V1.decodeTree input |> Maybe.map (V1.encodeTree >> Protobuf.Encode.encode) )
        , ( "codec.v1.WellKnown", \input -> Protobuf.Decode.decode V1.decodeWellKnown input |> Maybe.map (V1.encodeWellKnown >> Protobuf.Encode.encode) )
        , ( "codec.v1.Wrappers", \input -> Protobuf.Decode.decode V1.decodeWrappers input |> Maybe.map (V1.encodeWrappers >> Protobuf.Encode.encode) )
        , ( "codec.v1.Across", \input -> Protobuf.Decode.decode V1.decodeAcross input |> Maybe.map (V1.encodeAcross >> Protobuf.Encode.encode) )
        , ( "codec.v1.Leaf", \input -> Protobuf.Decode.decode V1.decodeLeaf input |> Maybe.map (V1.encodeLeaf >> Protobuf.Encode.encode) )
        , ( "codec.v1.Everything", \input -> Protobuf.Decode.decode V1.decodeEverything input |> Maybe.map (V1.encodeEverything >> Protobuf.Encode.encode) )
        ]


