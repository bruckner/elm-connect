[
  {
    "name": "proto refuses a method without binary codecs, unsent",
    "call": {
      "service": "notes.v1.NotesService",
      "method": "GetNote",
      "transport": "connect",
      "request": {
        "name": "notes/welcome"
      },
      "config": {
        "codec": "proto",
        "retry": {
          "attempts": 3,
          "codes": [
            "internal"
          ],
          "idempotentOnly": false
        }
      }
    },
    "expect": {
      "result": {
        "noAnswer": "MissingCodec notes.v1.NotesService/GetNote proto"
      },
      "trace": {
        "attempts": 0,
        "code": "internal"
      },
      "wire": []
    }
  },
  {
    "name": "proto Rpc.send refuses it too",
    "call": {
      "service": "notes.v1.NotesService",
      "method": "Ping",
      "transport": "connect",
      "request": {},
      "config": {
        "codec": "proto"
      },
      "send": "send"
    },
    "expect": {
      "result": {
        "noAnswer": "MissingCodec notes.v1.NotesService/Ping proto"
      },
      "wire": []
    }
  }
]
