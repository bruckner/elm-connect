[
  {
    "name": "stream envoy array, convert_grpc_status off WatchNotes: messages, then a clean end",
    "note": "Envoy's auto_mapping implicit route, a plain JSON POST; the array, convert_grpc_status off framing.",
    "call": {
      "service": "notes.v1.NotesService",
      "method": "WatchNotes",
      "transport": "transcode",
      "request": {
        "count": 2,
        "intervalMs": 10
      },
      "stream": {
        "framing": "envoyArray"
      }
    },
    "expect": {
      "result": {
        "events": [
          {
            "kind": "opened",
            "status": 200
          },
          {
            "kind": "message",
            "message": {
              "index": "1"
            }
          },
          {
            "kind": "message",
            "message": {
              "index": "2"
            }
          },
          {
            "kind": "ended",
            "trailers": {}
          }
        ]
      },
      "wire": [
        {
          "status": 200,
          "bodyEnd": "eof",
          "responseBody": {
            "$match": "^\\[\\{\"index\":\"1\""
          }
        }
      ]
    }
  },
  {
    "name": "stream envoy array, convert_grpc_status off WatchNotes: an error before the first message",
    "note": "Known divergence, recorded as it is: with convert_grpc_status off (the grpc_headers listener) the pre-stream error is not converted at all: 200, an empty array [], and grpc-status in the trailers. The page sees an empty stream that ended cleanly.",
    "call": {
      "service": "notes.v1.NotesService",
      "method": "WatchNotes",
      "transport": "transcode",
      "request": {
        "count": -1
      },
      "stream": {
        "framing": "envoyArray"
      }
    },
    "expect": {
      "result": {
        "events": [
          {
            "kind": "opened",
            "status": 200
          },
          {
            "kind": "ended",
            "trailers": {}
          }
        ]
      },
      "wire": [
        {
          "status": 200,
          "responseBody": "[]",
          "bodyEnd": "eof"
        }
      ]
    }
  },
  {
    "name": "stream envoy array, convert_grpc_status off WatchNotes: an error after the first message is invisible",
    "note": "Known divergence, recorded as it is: the server ends the stream with FAILED_PRECONDITION after two messages. Envoy has sent the 200 and its body, so it closes the body normally and puts grpc-status in HTTP/2 trailers (none at all over HTTP/1.1), which fetch cannot read; convert_grpc_status changes nothing here. What the page sees is a clean end.",
    "call": {
      "service": "notes.v1.NotesService",
      "method": "WatchNotes",
      "transport": "transcode",
      "request": {
        "count": 2,
        "intervalMs": 10,
        "fail": true
      },
      "stream": {
        "framing": "envoyArray"
      }
    },
    "expect": {
      "result": {
        "events": [
          {
            "kind": "opened",
            "status": 200
          },
          {
            "kind": "message",
            "message": {
              "index": "1"
            }
          },
          {
            "kind": "message",
            "message": {
              "index": "2"
            }
          },
          {
            "kind": "ended",
            "trailers": {}
          }
        ]
      },
      "wire": [
        {
          "status": 200,
          "bodyEnd": "eof"
        }
      ]
    }
  }
]
