    },
    "expect": {
      "result": {
        "ok": {
          "name": "notes/welcome",
          "title": "Welcome",
          "tags": [
            "intro",
            "example"
          ],
          "visibility": "VISIBILITY_PUBLIC",
          "createTime": "2026-01-01T00:00:00Z",
          "ttl": "90s",
          "metadata": {
            "lang": "en"
          },
          "extra": {
            "owner": "ada",
            "pinned": true,
            "stars": 3
          },
          "link": "https://example.com/welcome",
          "attachment": {
            "type": "google.protobuf.Timestamp",
            "value": "CKXr3MoG"
          },
          "revision": "9007199254740993"
        }
      }
    }
  },
