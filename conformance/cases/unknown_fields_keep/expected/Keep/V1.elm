                1 ->
                    4

                2 ->
                    4

                3 ->
                    4

                4 ->
                    4

                5 ->
                    4

                6 ->
                    4

                7 ->
                    5

                8 ->
                    2

                _ ->
                    0
        )
        (\value -> value.unknownFields_)
        (\v value ->
            { title = value.title
            , tags = value.tags
            , counts = value.counts
            , detail = value.detail
            , origin = value.origin
            , marks = value.marks
            , weight = value.weight
            , unknownFields_ = v
