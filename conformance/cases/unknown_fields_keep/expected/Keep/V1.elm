                            , tags = value.tags
                            , counts = value.counts
                            , detail = value.detail
                            , origin = value.origin
                            , marks = value.marks
                            , weight = value.weight
                            , unknownFields_ = value.unknownFields_
                            }
                        )
                        wire
                        value

                2 ->
                    Proto.Binary.repeated
                        Proto.Binary.string
                        (\v ->
                            { title = value.title
                            , tags = v
                            , counts = value.counts
                            , detail = value.detail
                            , origin = value.origin
                            , marks = value.marks
                            , weight = value.weight
                            , unknownFields_ = value.unknownFields_
