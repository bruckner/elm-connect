-- QUERY ENCODERS


{-| The query parameters of a [`Blob`](#Blob) for the HTTP bindings that put its fields in the query: those of its fields that hold a value, in declaration order.
-}
queryOfBlob : Blob -> List ( String, String )
queryOfBlob request_ =
    List.concat
        [ Proto.Query.bytes "digest" request_.digest
        , Proto.Query.string "name" request_.name
        , Proto.Query.bytes "salt" request_.salt
        ]


{-| The query parameters of a [`LabelBlobRequest`](#LabelBlobRequest) for the HTTP bindings that put its fields in the query: those of its fields that hold a value, in declaration order.
-}
queryOfLabelBlobRequest : LabelBlobRequest -> List ( String, String )
queryOfLabelBlobRequest request_ =
    Proto.Query.string "shelf" request_.shelf


{-| The query parameters of a [`Moment`](#Moment) for the HTTP bindings that put its fields in the query: those of its fields that hold a value, in declaration order.
-}
queryOfMoment : Moment -> List ( String, String )
queryOfMoment request_ =
    List.concat
        [ Proto.Query.string "name" request_.name
        , Proto.Query.optional "at" (Maybe.andThen Proto.Timestamp.toString request_.at)
        ]
