mergeNestedChainBytes =
    Proto.Binary.memo
        (\depth ->
            Proto.Binary.merge
                "cycles.v1.Chain"
                (\number wire value ->
                    case number of
                        1 ->
                            Proto.Binary.field
                                Proto.Binary.string
                                (\v ->
                                    { label = v
                                    , next = value.next
                                    , tree = value.tree
                                    }
                                )
                                wire
                                value

                        2 ->
                            Proto.Binary.fieldInto
                                (Proto.Binary.recursive depth encodeChain_Bytes mergeNestedChain_Bytes (Chain_ defaultChain))
                                value.next
                                (\v ->
                                    { label = value.label
                                    , next = Just v
                                    , tree = value.tree
                                    }
                                )
                                wire
                                value

                        3 ->
                            Proto.Binary.fieldInto
                                (Proto.Binary.recursive depth encodeTreeBytes mergeNestedTreeBytes defaultTree)
                                value.tree
                                (\v ->
                                    { label = value.label
                                    , next = value.next
                                    , tree = Just v
                                    }
                                )
                                wire
                                value

                        _ ->
                            Proto.Binary.skip wire value
                )
                identity
        )


